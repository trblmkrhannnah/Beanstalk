@page "/join/{InviteCode}"

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject RoleManager<IdentityRole<Guid>> RoleManager

<h3 class="text-2xl font-bold mb-6">Join via Invite</h3>

@if (!_inviteValid)
{
    <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700 mb-4" role="alert">
        <p class="font-semibold mb-2">Invalid or expired invite link.</p>
        <p>@_inviteErrorMessage</p>
    </div>
    <p><a class="btn-primary px-6 py-2 rounded-md font-medium transition-colors inline-block" href="/">Go to Home</a></p>
}
else
{
    <p class="mb-6 text-gray-700">You've been invited to join Beanstalk! Create your account below.</p>
    
    <EditForm Model="Model" OnValidSubmit="RegisterAsync" FormName="register-invite" method="post" class="space-y-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-4 p-4 bg-red-50 border border-red-200 rounded text-red-700" />
        @if (!string.IsNullOrEmpty(_validationMessage))
        {
            <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700" role="alert">
                @_validationMessage
            </div>
        }
        <div class="mb-4">
            <label for="reg-username" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
            <InputText id="reg-username" class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-primary focus:border-primary" @bind-Value="Model.Username" />
        </div>
        <div class="mb-4">
            <label for="reg-password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
            <InputText id="reg-password" class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-primary focus:border-primary" @bind-Value="Model.Password" type="password" />
        </div>
        <div class="mb-4">
            <label for="reg-confirm-password" class="block text-sm font-medium text-gray-700 mb-2">Confirm Password</label>
            <InputText id="reg-confirm-password" class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-primary focus:border-primary" @bind-Value="Model.ConfirmPassword" type="password" />
        </div>
        <button class="btn-primary px-6 py-2 rounded-md font-medium transition-colors" type="submit">Register</button>
    </EditForm>
}

@code {
    [Parameter]
    public string InviteCode { get; set; } = string.Empty;

    private bool _inviteValid = false;
    private string _inviteErrorMessage = string.Empty;
    private InviteLink? _invite;

    [SupplyParameterFromForm]
    private RegisterModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await ValidateInviteAsync();
    }

    private async Task ValidateInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(InviteCode))
        {
            _inviteValid = false;
            _inviteErrorMessage = "No invite code provided.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        
        _invite = await db.InviteLinks
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Code == InviteCode);

        if (_invite == null)
        {
            _inviteValid = false;
            _inviteErrorMessage = "This invite link does not exist.";
            return;
        }

        if (!_invite.IsActive)
        {
            _inviteValid = false;
            _inviteErrorMessage = "This invite link has been deactivated.";
            return;
        }

        if (_invite.MaxUses.HasValue && _invite.CurrentUses >= _invite.MaxUses.Value)
        {
            _inviteValid = false;
            _inviteErrorMessage = "This invite link has reached its maximum number of uses.";
            return;
        }

        if (_invite.ExpiresUtc.HasValue && _invite.ExpiresUtc.Value < DateTime.UtcNow)
        {
            _inviteValid = false;
            _inviteErrorMessage = "This invite link has expired.";
            return;
        }

        _inviteValid = true;
    }

    private async Task RegisterAsync()
    {
        if (_invite == null)
        {
            _validationMessage = "Invalid invite link.";
            return;
        }

        _validationMessage = null;
        var username = Model.Username?.Trim() ?? string.Empty;
        if (username.Length < 5)
        {
            _validationMessage = "Username must be at least 5 characters.";
            return;
        }
        if (!Regex.IsMatch(username, "^[a-zA-Z0-9_-]{5,}$"))
        {
            _validationMessage = "Only letters, numbers, dashes, and underscores allowed.";
            return;
        }
        if (_reservedUsernames.Contains(username, StringComparer.OrdinalIgnoreCase))
        {
            _validationMessage = "That username is reserved.";
            return;
        }

        var existing = await UserManager.FindByNameAsync(username);
        if (existing != null)
        {
            _validationMessage = "Username already exists.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        
        // Revalidate invite before proceeding (check for race conditions)
        var currentInvite = await db.InviteLinks.FirstOrDefaultAsync(i => i.Code == InviteCode);
        if (currentInvite == null || !currentInvite.IsActive || 
            (currentInvite.MaxUses.HasValue && currentInvite.CurrentUses >= currentInvite.MaxUses.Value))
        {
            _validationMessage = "This invite link is no longer valid.";
            return;
        }

        // Create user (UserManager handles its own transaction)
        var user = new ApplicationUser { UserName = username, IsPublished = true };
        var result = await UserManager.CreateAsync(user, Model.Password);
        if (!result.Succeeded)
        {
            _validationMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        // Create profile and update invite usage
        db.UserProfiles.Add(new UserProfile
        {
            Id = Guid.NewGuid(),
            UserId = user.Id,
            DisplayName = username,
            Bio = "I'm new here, please be nice!",
            CreatedUtc = DateTime.UtcNow
        });

        // Increment invite uses
        currentInvite.CurrentUses++;
        
        // Auto-deactivate if max uses reached
        if (currentInvite.MaxUses.HasValue && currentInvite.CurrentUses >= currentInvite.MaxUses.Value)
        {
            currentInvite.IsActive = false;
        }

        await db.SaveChangesAsync();
        
        // First-user-admin bootstrap (though this is unlikely via invite)
        var userCount = await db.Users.CountAsync();
        if (userCount == 1)
        {
            const string adminRole = "Admin";
            if (!await RoleManager.RoleExistsAsync(adminRole))
            {
                await RoleManager.CreateAsync(new IdentityRole<Guid>(adminRole));
            }
            await UserManager.AddToRoleAsync(user, adminRole);
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        Nav.NavigateTo("/edit/", true);
    }

    private string? _validationMessage;
    private static readonly HashSet<string> _reservedUsernames = new(["config","admin","login","register","api","assets","static","_content","join"]);

    private class RegisterModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        [MinLength(6)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}



