@page "/"
@using Beanstalk.App.Features

@inject BeanstalkNavigator Navigator

<div class="flex gap-3">
    <a class="btn-primary px-6 py-2 rounded-md font-medium transition-colors inline-block" href="/home/register">Get Started</a>
    <a class="px-6 py-2 rounded-md font-medium border-2 border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors inline-block" href="/home/login">Log in</a>
</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Navigator.NavigateToEditIfLoggedInAsync();
    }

}