@page "/"
@using Beanstalk.App.Features

@inject BeanstalkNavigator Navigator

<p>
    <a class="btn btn-primary" href="/home/register">Get Started</a>
    <a class="btn btn-outline-secondary ms-2" href="/home/login">Log in</a>
</p>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Navigator.NavigateToEditIfLoggedInAsync();
    }

}