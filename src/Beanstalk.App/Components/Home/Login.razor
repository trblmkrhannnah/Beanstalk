@page "/home/login"

@using System.ComponentModel.DataAnnotations
@using Beanstalk.Database.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

<div class="card-cute mx-auto" style="max-width: 28rem;">
    <h3 class="display-6 fw-bold mb-4 text-center gradient-text">✨ Login</h3>

    <EditForm Model="Model" OnValidSubmit="LoginAsync" FormName="login" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3 p-3 bg-red-50 border border-red-200 text-red-700 rounded" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="p-3 bg-red-50 border border-red-200 text-red-700 rounded mb-3" role="alert">
                @_error
            </div>
        }
        <div class="mb-3">
            <label for="login-username" class="form-label small fw-medium text-gray-700">👤 Username</label>
            <InputText id="login-username" class="input-cute" @bind-Value="Model.Username" />
        </div>
        <div class="mb-3">
            <label for="login-password" class="form-label small fw-medium text-gray-700">🔒 Password</label>
            <InputText id="login-password" class="input-cute" @bind-Value="Model.Password" type="password" />
        </div>
        <button class="btn-primary w-100" type="submit">🚀 Login</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel Model { get; set; } = new();

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Model.Username, Model.Password, true, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            Nav.NavigateTo("/edit/", true);
        }
        else if (result.RequiresTwoFactor)
        {
            // Store username in session or pass as parameter
            Nav.NavigateTo($"/home/login-2fa?returnUrl={Uri.EscapeDataString("/edit/")}", true);
        }
        else if (result.IsLockedOut)
        {
            _error = "Account is locked out. Please try again later.";
        }
        else
        {
            _error = "Invalid username or password.";
        }
    }

    private string? _error;

    private class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}


