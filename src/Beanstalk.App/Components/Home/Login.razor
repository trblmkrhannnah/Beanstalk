@page "/home/login"

@using System.ComponentModel.DataAnnotations
@using Beanstalk.Database.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

<div class="card-cute max-w-md mx-auto">
    <h3 class="text-3xl font-bold mb-6 text-center bg-gradient-to-r from-pink-500 to-lavender-500 bg-clip-text text-transparent">✨ Login</h3>

    <EditForm Model="Model" OnValidSubmit="LoginAsync" FormName="login" method="post" class="space-y-4">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-4 p-4 bg-red-50 border-2 border-red-200 rounded-2xl text-red-700" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="p-4 bg-red-50 border-2 border-red-200 rounded-2xl text-red-700" role="alert">
                @_error
            </div>
        }
        <div class="mb-4">
            <label for="login-username" class="block text-sm font-medium text-gray-700 mb-2">👤 Username</label>
            <InputText id="login-username" class="input-cute" @bind-Value="Model.Username" />
        </div>
        <div class="mb-4">
            <label for="login-password" class="block text-sm font-medium text-gray-700 mb-2">🔒 Password</label>
            <InputText id="login-password" class="input-cute" @bind-Value="Model.Password" type="password" />
        </div>
        <button class="btn-primary w-full" type="submit">🚀 Login</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel Model { get; set; } = new();

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Model.Username, Model.Password, true, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            Nav.NavigateTo("/edit/dashboard", true);
        }
        else if (result.RequiresTwoFactor)
        {
            // Store username in session or pass as parameter
            Nav.NavigateTo($"/home/login-2fa?returnUrl={Uri.EscapeDataString("/edit/dashboard")}", true);
        }
        else if (result.IsLockedOut)
        {
            _error = "Account is locked out. Please try again later.";
        }
        else
        {
            _error = "Invalid username or password.";
        }
    }

    private string? _error;

    private class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}


