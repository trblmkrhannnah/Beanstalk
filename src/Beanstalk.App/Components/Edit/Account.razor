@page "/edit/account"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using QRCoder
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<CascadingAuthenticationState>
<AuthorizeView Context="auth">
    <Authorized>
        @if (_loading)
        {
            <p>Loading...</p>
        }
        else if (_user is null)
        {
            <p>User not found.</p>
        }
        else
        {
            <h3>Account Settings</h3>
            
            <!-- Change Password Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Change Password</h5>
                    <EditForm Model="PasswordModel" OnValidSubmit="ChangePasswordAsync">
                        <DataAnnotationsValidator/>
                        <ValidationSummary/>
                        
                        @if (!string.IsNullOrEmpty(_passwordError))
                        {
                            <div class="alert alert-danger">@_passwordError</div>
                        }
                        
                        @if (_passwordChanged)
                        {
                            <div class="alert alert-success">Password changed successfully.</div>
                        }
                        
                        <div class="mb-3">
                            <label for="current-password" class="form-label">Current Password</label>
                            <InputText id="current-password" type="password" class="form-control" @bind-Value="PasswordModel.CurrentPassword"/>
                        </div>
                        <div class="mb-3">
                            <label for="new-password" class="form-label">New Password</label>
                            <InputText id="new-password" type="password" class="form-control" @bind-Value="PasswordModel.NewPassword"/>
                        </div>
                        <div class="mb-3">
                            <label for="confirm-password" class="form-label">Confirm New Password</label>
                            <InputText id="confirm-password" type="password" class="form-control" @bind-Value="PasswordModel.ConfirmPassword"/>
                        </div>
                        <button class="btn btn-primary" type="submit">Change Password</button>
                    </EditForm>
                </div>
            </div>

            
            <!-- Two-Factor Authentication Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Two-Factor Authentication</h5>
                    
                    @if (_twoFactorLoading)
                    {
                        <p>Loading...</p>
                    }
                    else if (!_twoFactorEnabled)
                    {
                        @if (_setupStep == TwoFactorSetupStep.NotStarted)
                        {
                            <p class="card-text">Add an extra layer of security to your account by enabling two-factor authentication (2FA). You'll need an authenticator app like Google Authenticator, Microsoft Authenticator, or Authy.</p>
                            <button class="btn btn-primary" type="button" @onclick="StartTwoFactorSetup">Enable Two-Factor Authentication</button>
                        }
                        else if (_setupStep == TwoFactorSetupStep.ShowingQrCode)
                        {
                            <div class="alert alert-info">
                                <strong>Step 1 of 2:</strong> Scan the QR code or enter the key manually
                            </div>
                            
                            @if (!string.IsNullOrEmpty(_qrCodeImageUrl))
                            {
                                <div class="text-center mb-3">
                                    <img src="@_qrCodeImageUrl" alt="QR Code" style="max-width: 300px;" />
                                </div>
                            }
                            
                            <div class="mb-3">
                                <label class="form-label">Manual Entry Key</label>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" value="@_authenticatorKey" readonly />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="CopyKeyToClipboard">Copy</button>
                                </div>
                                <small class="form-text text-muted">Enter this key into your authenticator app if you can't scan the QR code.</small>
                            </div>
                            
                            <EditForm Model="VerifySetupModel" OnValidSubmit="VerifyTwoFactorSetup">
                                <DataAnnotationsValidator/>
                                <ValidationSummary/>
                                
                                @if (!string.IsNullOrEmpty(_setupError))
                                {
                                    <div class="alert alert-danger">@_setupError</div>
                                }
                                
                                <div class="mb-3">
                                    <label for="verify-code" class="form-label">Verification Code</label>
                                    <InputText id="verify-code" class="form-control" @bind-Value="VerifySetupModel.Code" placeholder="000000" maxlength="6"/>
                                    <small class="form-text text-muted">Enter the 6-digit code from your authenticator app to verify.</small>
                                </div>
                                
                                <button class="btn btn-primary me-2" type="submit">Verify & Continue</button>
                                <button class="btn btn-secondary" type="button" @onclick="CancelTwoFactorSetup">Cancel</button>
                            </EditForm>
                        }
                        else if (_setupStep == TwoFactorSetupStep.ShowingRecoveryCodes)
                        {
                            <div class="alert alert-warning">
                                <strong>Step 2 of 2:</strong> Save your recovery codes
                            </div>
                            
                            <div class="alert alert-danger">
                                <strong>Important:</strong> Save these recovery codes in a safe place. Each code can only be used once. If you lose access to your authenticator device, you'll need these codes to log in.
                            </div>
                            
                            @if (_recoveryCodes != null && _recoveryCodes.Any())
                            {
                                <div class="mb-3">
                                    <div class="border rounded p-3 bg-light font-monospace" style="column-count: 2; column-gap: 20px;">
                                        @foreach (var recoveryCode in _recoveryCodes)
                                        {
                                            <div class="mb-1">@recoveryCode</div>
                                        }
                                    </div>
                                </div>
                                
                                <button class="btn btn-outline-primary me-2" type="button" @onclick="CopyRecoveryCodesToClipboard">Copy All Codes</button>
                                <button class="btn btn-outline-primary me-2" type="button" @onclick="DownloadRecoveryCodes">Download Codes</button>
                            }
                            
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirm-saved" @bind="_confirmSavedCodes" />
                                <label class="form-check-label" for="confirm-saved">
                                    I have saved my recovery codes in a safe place
                                </label>
                            </div>
                            
                            <button class="btn btn-success" type="button" @onclick="FinishTwoFactorSetup" disabled="@(!_confirmSavedCodes)">
                                Finish Setup
                            </button>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <strong>Two-factor authentication is enabled</strong> - Your account is protected with an additional security layer.
                        </div>
                        
                        <div class="mb-3">
                            <button class="btn btn-primary me-2" type="button" @onclick="ShowRegenerateRecoveryCodes">Regenerate Recovery Codes</button>
                            <button class="btn btn-danger" type="button" @onclick="ShowDisableTwoFactor">Disable Two-Factor Authentication</button>
                        </div>
                        
                        @if (_showRegenerateCodes)
                        {
                            <div class="card border-warning mb-3">
                                <div class="card-body">
                                    <h6 class="card-title">Regenerate Recovery Codes</h6>
                                    <p class="card-text">This will generate new recovery codes and invalidate your old ones. Make sure to save the new codes.</p>
                                    
                                    @if (_regeneratedCodes != null && _regeneratedCodes.Any())
                                    {
                                        <div class="alert alert-warning">
                                            <strong>Your new recovery codes:</strong>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <div class="border rounded p-3 bg-light font-monospace" style="column-count: 2; column-gap: 20px;">
                                                @foreach (var recoveryCode in _regeneratedCodes)
                                                {
                                                    <div class="mb-1">@recoveryCode</div>
                                                }
                                            </div>
                                        </div>
                                        
                                        <button class="btn btn-outline-primary me-2" type="button" @onclick="CopyRegeneratedCodesToClipboard">Copy All Codes</button>
                                        <button class="btn btn-outline-primary me-2" type="button" @onclick="DownloadRegeneratedCodes">Download Codes</button>
                                        <button class="btn btn-secondary" type="button" @onclick="CloseRegenerateCodes">Close</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning me-2" type="button" @onclick="RegenerateRecoveryCodes">Generate New Codes</button>
                                        <button class="btn btn-secondary" type="button" @onclick="CloseRegenerateCodes">Cancel</button>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (_showDisable2FA)
                        {
                            <div class="card border-danger mb-3">
                                <div class="card-body">
                                    <h6 class="card-title text-danger">Disable Two-Factor Authentication</h6>
                                    <p class="card-text">This will remove the additional security layer from your account.</p>
                                    
                                    <EditForm Model="DisableModel" OnValidSubmit="DisableTwoFactorAsync">
                                        <DataAnnotationsValidator/>
                                        <ValidationSummary/>
                                        
                                        @if (!string.IsNullOrEmpty(_disable2FAError))
                                        {
                                            <div class="alert alert-danger">@_disable2FAError</div>
                                        }
                                        
                                        <div class="mb-3">
                                            <label for="disable-password" class="form-label">Enter your password to confirm</label>
                                            <InputText id="disable-password" type="password" class="form-control" @bind-Value="DisableModel.Password"/>
                                        </div>
                                        
                                        <button class="btn btn-danger me-2" type="submit">Yes, Disable 2FA</button>
                                        <button class="btn btn-secondary" type="button" @onclick="CancelDisable2FA">Cancel</button>
                                    </EditForm>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            
            <!-- Delete Account Section -->
            <div class="card border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Delete Account</h5>
                    <p class="card-text">Once you delete your account, there is no going back. Please be certain.</p>
                    
                    @if (_deletingAccount)
                    {
                        <div class="alert alert-info">
                            <strong>Deleting account...</strong> Please wait.
                        </div>
                    }
                    else if (!_showDeleteConfirmation)
                    {
                        <button class="btn btn-danger" type="button" @onclick="ShowDeleteConfirmation">Delete Account</button>
                    }
                    else
                    {
                        <EditForm Model="DeleteModel" OnValidSubmit="DeleteAccountAsync">
                            <DataAnnotationsValidator/>
                            <ValidationSummary/>
                            
                            @if (!string.IsNullOrEmpty(_deleteError))
                            {
                                <div class="alert alert-danger">@_deleteError</div>
                            }
                            
                            <div class="alert alert-warning">
                                <strong>Warning:</strong> This action cannot be undone. All your data including your profile, links, and images will be permanently deleted.
                            </div>
                            
                            <div class="mb-3">
                                <label for="delete-password" class="form-label">Enter your password to confirm</label>
                                <InputText id="delete-password" type="password" class="form-control" @bind-Value="DeleteModel.Password"/>
                            </div>
                            
                            <button class="btn btn-danger me-2" type="submit">Yes, Delete My Account</button>
                            <button class="btn btn-secondary" type="button" @onclick="CancelDelete">Cancel</button>
                        </EditForm>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <PleaseLogIn />
    </NotAuthorized>
</AuthorizeView>
</CascadingAuthenticationState>

@code {
    private ApplicationUser? _user;
    private ChangePasswordModel PasswordModel { get; set; } = new();
    private DeleteAccountModel DeleteModel { get; set; } = new();
    private bool _loading = true;
    private bool _passwordChanged;
    private string? _passwordError;
    private bool _showDeleteConfirmation;
    private string? _deleteError;
    private bool _deletingAccount;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _passwordChanged = false;
        _passwordError = null;
        _deleteError = null;
        
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);

        await LoadTwoFactorStatusAsync();

        _loading = false;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordChanged = false;
        _passwordError = null;

        if (_user == null || PasswordModel == null)
        {
            _passwordError = "User not found.";
            return;
        }

        if (PasswordModel.NewPassword != PasswordModel.ConfirmPassword)
        {
            _passwordError = "New password and confirmation do not match.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(_user, PasswordModel.CurrentPassword, PasswordModel.NewPassword);

        if (result.Succeeded)
        {
            _passwordChanged = true;
            PasswordModel = new(); // Reset form
            StateHasChanged();
        }
        else
        {
            _passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteConfirmation = true;
        _deleteError = null;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        DeleteModel = new();
        _deleteError = null;
        StateHasChanged();
    }

    private async Task DeleteAccountAsync()
    {
        _deleteError = null;

        if (_user == null || DeleteModel == null)
        {
            _deleteError = "User not found.";
            return;
        }

        // Verify password before deletion
        var passwordCheck = await SignInManager.CheckPasswordSignInAsync(_user, DeleteModel.Password, false);
        if (!passwordCheck.Succeeded)
        {
            _deleteError = "Incorrect password. Account deletion cancelled.";
            return;
        }

        // Set deleting state to show loading message
        _deletingAccount = true;
        StateHasChanged();

        // Give UI time to render the "Deleting..." message
        await Task.Delay(200);

        // Delete user profile and related data
        IdentityResult deleteResult;
        try
        {
            var profile = await Db.UserProfiles.FirstOrDefaultAsync(p => p.UserId == _user.Id);
            if (profile != null)
            {
                // Delete profile links
                var links = await Db.ProfileLinks.Where(l => l.ProfileId == profile.Id).ToListAsync();
                Db.ProfileLinks.RemoveRange(links);

                // Delete profile images
                var images = await Db.ProfileImages.Where(i => i.ProfileId == profile.Id).ToListAsync();
                Db.ProfileImages.RemoveRange(images);

                // Delete profile
                Db.UserProfiles.Remove(profile);
            }

            await Db.SaveChangesAsync();

            // Delete the user account
            deleteResult = await UserManager.DeleteAsync(_user);
        }
        catch (Exception)
        {
            _deletingAccount = false;
            _deleteError = "An error occurred while deleting your account. Please try again.";
            StateHasChanged();
            return;
        }

        // Handle the result
        if (deleteResult.Succeeded)
        {
            // Account deleted successfully - navigate to logout page which will clean up session
            // Use forceLoad to ensure a clean browser-level navigation
            Nav.NavigateTo("/home/logout", forceLoad: true);
        }
        else
        {
            _deletingAccount = false;
            _deleteError = string.Join(" ", deleteResult.Errors.Select(e => e.Description));
            StateHasChanged();
        }
    }

    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required")]
        [StringLength(100, ErrorMessage = "Password must be at least {2} characters long.", MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password confirmation is required")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private class DeleteAccountModel
    {
        [Required(ErrorMessage = "Password is required to delete account")]
        public string Password { get; set; } = string.Empty;
    }

    // Two-Factor Authentication
    private bool _twoFactorEnabled;
    private bool _twoFactorLoading;
    private TwoFactorSetupStep _setupStep = TwoFactorSetupStep.NotStarted;
    private string? _authenticatorKey;
    private string? _qrCodeImageUrl;
    private IEnumerable<string>? _recoveryCodes;
    private IEnumerable<string>? _regeneratedCodes;
    private bool _confirmSavedCodes;
    private string? _setupError;
    private bool _showRegenerateCodes;
    private bool _showDisable2FA;
    private string? _disable2FAError;
    
    private VerifyCodeModel VerifySetupModel { get; set; } = new();
    private DisableTwoFactorModel DisableModel { get; set; } = new();

    private async Task LoadTwoFactorStatusAsync()
    {
        _twoFactorLoading = true;
        if (_user != null)
        {
            _twoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(_user);
        }
        _twoFactorLoading = false;
    }

    private async Task StartTwoFactorSetup()
    {
        if (_user == null) return;

        // Reset the authenticator key
        await UserManager.ResetAuthenticatorKeyAsync(_user);
        _authenticatorKey = await UserManager.GetAuthenticatorKeyAsync(_user);

        if (string.IsNullOrEmpty(_authenticatorKey))
        {
            _setupError = "Failed to generate authenticator key. Please try again.";
            return;
        }

        // Generate QR code
        var appName = "Beanstalk";
        var authenticatorUri = GenerateQrCodeUri(_authenticatorKey, _user.UserName ?? "user", appName);
        _qrCodeImageUrl = GenerateQrCodeImage(authenticatorUri);

        _setupStep = TwoFactorSetupStep.ShowingQrCode;
        _setupError = null;
        StateHasChanged();
    }

    private string GenerateQrCodeUri(string key, string username, string issuer)
    {
        return $"otpauth://totp/{UrlEncoder.Default.Encode(issuer)}:{UrlEncoder.Default.Encode(username)}?secret={key}&issuer={UrlEncoder.Default.Encode(issuer)}&digits=6";
    }

    private string GenerateQrCodeImage(string data)
    {
        using var qrGenerator = new QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(data, QRCodeGenerator.ECCLevel.Q);
        using var qrCode = new PngByteQRCode(qrCodeData);
        var qrCodeBytes = qrCode.GetGraphic(20);
        return $"data:image/png;base64,{Convert.ToBase64String(qrCodeBytes)}";
    }

    private async Task CopyKeyToClipboard()
    {
        if (!string.IsNullOrEmpty(_authenticatorKey))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _authenticatorKey);
        }
    }

    private async Task VerifyTwoFactorSetup()
    {
        if (_user == null)
        {
            _setupError = "User not found.";
            return;
        }

        var code = VerifySetupModel.Code?.Replace(" ", "").Replace("-", "") ?? "";
        
        if (string.IsNullOrEmpty(code) || code.Length != 6)
        {
            _setupError = "Please enter a valid 6-digit code.";
            return;
        }

        // Verify the code
        var isValid = await UserManager.VerifyTwoFactorTokenAsync(_user, UserManager.Options.Tokens.AuthenticatorTokenProvider, code);

        if (!isValid)
        {
            _setupError = "Invalid verification code. Please check your authenticator app and try again.";
            return;
        }

        // Enable 2FA
        await UserManager.SetTwoFactorEnabledAsync(_user, true);

        // Generate recovery codes
        _recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);

        _setupStep = TwoFactorSetupStep.ShowingRecoveryCodes;
        _setupError = null;
        _confirmSavedCodes = false;
        VerifySetupModel = new();
        StateHasChanged();
    }

    private async Task CopyRecoveryCodesToClipboard()
    {
        if (_recoveryCodes != null)
        {
            var codesText = string.Join("\n", _recoveryCodes);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", codesText);
        }
    }

    private async Task DownloadRecoveryCodes()
    {
        if (_recoveryCodes != null)
        {
            var codesText = string.Join("\n", _recoveryCodes);
            var fileName = $"beanstalk-recovery-codes-{DateTime.UtcNow:yyyyMMdd}.txt";
            await JSRuntime.InvokeVoidAsync("downloadTextFile", fileName, codesText);
        }
    }

    private void FinishTwoFactorSetup()
    {
        if (!_confirmSavedCodes)
        {
            return;
        }

        _twoFactorEnabled = true;
        _setupStep = TwoFactorSetupStep.NotStarted;
        _recoveryCodes = null;
        _authenticatorKey = null;
        _qrCodeImageUrl = null;
        StateHasChanged();
    }

    private void CancelTwoFactorSetup()
    {
        _setupStep = TwoFactorSetupStep.NotStarted;
        _setupError = null;
        _authenticatorKey = null;
        _qrCodeImageUrl = null;
        _recoveryCodes = null;
        VerifySetupModel = new();
        StateHasChanged();
    }

    private void ShowRegenerateRecoveryCodes()
    {
        _showRegenerateCodes = true;
        _regeneratedCodes = null;
        StateHasChanged();
    }

    private void CloseRegenerateCodes()
    {
        _showRegenerateCodes = false;
        _regeneratedCodes = null;
        StateHasChanged();
    }

    private async Task RegenerateRecoveryCodes()
    {
        if (_user == null) return;

        _regeneratedCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);
        StateHasChanged();
    }

    private async Task CopyRegeneratedCodesToClipboard()
    {
        if (_regeneratedCodes != null)
        {
            var codesText = string.Join("\n", _regeneratedCodes);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", codesText);
        }
    }

    private async Task DownloadRegeneratedCodes()
    {
        if (_regeneratedCodes != null)
        {
            var codesText = string.Join("\n", _regeneratedCodes);
            var fileName = $"beanstalk-recovery-codes-{DateTime.UtcNow:yyyyMMdd}.txt";
            await JSRuntime.InvokeVoidAsync("downloadTextFile", fileName, codesText);
        }
    }

    private void ShowDisableTwoFactor()
    {
        _showDisable2FA = true;
        _disable2FAError = null;
        DisableModel = new();
        StateHasChanged();
    }

    private void CancelDisable2FA()
    {
        _showDisable2FA = false;
        _disable2FAError = null;
        DisableModel = new();
        StateHasChanged();
    }

    private async Task DisableTwoFactorAsync()
    {
        if (_user == null)
        {
            _disable2FAError = "User not found.";
            return;
        }

        // Verify password
        var passwordCheck = await SignInManager.CheckPasswordSignInAsync(_user, DisableModel.Password, false);
        if (!passwordCheck.Succeeded)
        {
            _disable2FAError = "Incorrect password.";
            return;
        }

        // Disable 2FA
        await UserManager.SetTwoFactorEnabledAsync(_user, false);
        await UserManager.ResetAuthenticatorKeyAsync(_user);

        _twoFactorEnabled = false;
        _showDisable2FA = false;
        DisableModel = new();
        StateHasChanged();
    }

    private enum TwoFactorSetupStep
    {
        NotStarted,
        ShowingQrCode,
        ShowingRecoveryCodes
    }

    private class VerifyCodeModel
    {
        [Required(ErrorMessage = "Verification code is required")]
        public string Code { get; set; } = string.Empty;
    }

    private class DisableTwoFactorModel
    {
        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }
}



