@page "/edit/links"
@rendermode InteractiveServer

@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using System.Text.RegularExpressions

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div @onclick="CloseMenuIfOutside">
            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading links...</p>
            }
            else if (_profile is null || _user is null)
            {
                <div class="card-cute text-center py-12">
                    <p class="text-gray-600">Profile not found.</p>
                </div>
            }
            else
            {
                <!-- Breadcrumbs -->
                <nav class="mb-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2 text-sm text-gray-600">
                        <li><a href="/edit/links" class="hover:text-gray-900">Links</a></li>
                    </ol>
                </nav>

                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900">Links</h3>
                        <p class="text-sm sm:text-base text-gray-600">Add and organize links for your profile page.</p>
                    </div>
                    <button class="btn-primary" @onclick="NavigateToCreate" disabled="@(_links.Count >= 20)">
                        Create New Link
                    </button>
                </div>

                <div class="space-y-6">
                    <!-- Links List -->
                    @if (_links.Count == 0)
                    {
                        <div class="card-cute text-center py-16 bg-gray-50">
                            <h4 class="text-2xl font-semibold text-gray-800 mb-2">No Links Yet</h4>
                            <p class="text-gray-600 mb-6">Add links to your social media, portfolio, or any other pages you want to share!</p>
                            <button class="btn-primary" @onclick="NavigateToCreate">
                                Add Your First Link
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @for (int i = 0; i < _links.Count; i++)
                            {
                                var link = _links[i];
                                var index = i;
                                var isValidUrl = !string.IsNullOrWhiteSpace(link.Url) && Uri.TryCreate(link.Url, UriKind.Absolute, out _);
                                
                                <div class="card-cute @(link.IsVisible ? "" : "opacity-60")">
                                    <div class="flex items-center gap-4">
                                        <!-- Up/Down Arrow Buttons -->
                                        <div class="flex flex-col flex-shrink-0 gap-1">
                                            <button class="p-1 text-gray-400 hover:text-gray-600 disabled:text-gray-200 disabled:cursor-not-allowed transition-colors"
                                                    @onclick="(() => MoveLinkUp(index))"
                                                    disabled="@(index == 0)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                </svg>
                                            </button>
                                            <button class="p-1 text-gray-400 hover:text-gray-600 disabled:text-gray-200 disabled:cursor-not-allowed transition-colors"
                                                    @onclick="(() => MoveLinkDown(index))"
                                                    disabled="@(index == _links.Count - 1)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                                </svg>
                                            </button>
                                        </div>

                                        <!-- Link Content -->
                                        <div class="flex-1 flex items-center justify-between">
                                            <div class="flex-1">
                                                @if (isValidUrl && !string.IsNullOrWhiteSpace(link.Title))
                                                {
                                                    <a href="@link.Url" target="_blank" rel="noopener" 
                                                       class="flex items-center gap-3 hover:text-indigo-600 transition-colors">
                                                        <span class="font-semibold text-gray-800">@link.Title</span>
                                                        <span class="text-xs text-gray-500 truncate max-w-md">@link.Url</span>
                                                        @if (!link.IsVisible)
                                                        {
                                                            <span class="text-xs px-2 py-1 bg-gray-200 text-gray-600 rounded">Hidden</span>
                                                        }
                                                        <span class="text-gray-400">→</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="flex items-center gap-3">
                                                        <span class="font-semibold text-gray-400">@(string.IsNullOrWhiteSpace(link.Title) ? "Untitled Link" : link.Title)</span>
                                                        @if (!link.IsVisible)
                                                        {
                                                            <span class="text-xs px-2 py-1 bg-gray-200 text-gray-600 rounded">Hidden</span>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <!-- Three Dots Menu -->
                                            <div class="relative flex-shrink-0" @onclick:stopPropagation="true">
                                                <button class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors" 
                                                        @onclick="(() => ToggleMenu(link.Id))">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                                                    </svg>
                                                </button>

                                                @if (_openMenuId == link.Id)
                                                {
                                                    <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50">
                                                        <button class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors" 
                                                                @onclick="(() => ToggleVisibility(link))">
                                                            @(link.IsVisible ? "Disable" : "Enable")
                                                        </button>
                                                        <button class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors" 
                                                                @onclick="(() => NavigateToEdit(link.Id))">
                                                            Edit
                                                        </button>
                                                        <button class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors" 
                                                                @onclick="(() => DeleteLink(link))">
                                                            Delete
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            </div>
        </Authorized>
        <NotAuthorized>
            <PleaseLogIn />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private ApplicationUser? _user;
    private UserProfile? _profile;
    private List<ProfileLink> _links = new();
    private bool _loading = true;
    private Guid? _openMenuId = null;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);
        if (_user != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            _profile = await db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == _user.Id);
            if (_profile != null)
            {
                _links = await db.ProfileLinks
                    .AsNoTracking()
                    .Where(l => l.ProfileId == _profile.Id)
                    .OrderBy(l => l.SortOrder)
                    .ToListAsync();
            }
        }

        _loading = false;
    }

    private async Task MoveLinkUp(int index)
    {
        if (index <= 0 || index >= _links.Count)
            return;

        // Swap with item above
        var temp = _links[index];
        _links[index] = _links[index - 1];
        _links[index - 1] = temp;

        Reindex();
        await SaveOrderAsync();
        StateHasChanged();
    }

    private async Task MoveLinkDown(int index)
    {
        if (index < 0 || index >= _links.Count - 1)
            return;

        // Swap with item below
        var temp = _links[index];
        _links[index] = _links[index + 1];
        _links[index + 1] = temp;

        Reindex();
        await SaveOrderAsync();
        StateHasChanged();
    }

    private void NavigateToCreate()
    {
        Nav.NavigateTo("/edit/links/create");
    }

    private void NavigateToEdit(Guid linkId)
    {
        _openMenuId = null;
        Nav.NavigateTo($"/edit/links/edit/{linkId}");
    }

    private void ToggleMenu(Guid linkId)
    {
        _openMenuId = _openMenuId == linkId ? null : linkId;
        StateHasChanged();
    }

    private void CloseMenuIfOutside()
    {
        if (_openMenuId != null)
        {
            _openMenuId = null;
            StateHasChanged();
        }
    }

    private async Task ToggleVisibility(ProfileLink link)
    {
        _openMenuId = null;
        link.IsVisible = !link.IsVisible;
        await SaveAsync();
    }

    private async Task DeleteLink(ProfileLink link)
    {
        _openMenuId = null;
        _links.Remove(link);
        Reindex();
        await SaveAsync();
    }

    private void Reindex()
    {
        for (int i = 0; i < _links.Count; i++)
        {
            _links[i].SortOrder = i;
        }
    }

    private async Task SaveOrderAsync()
    {
        if (_user == null || _profile == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var existing = await db.ProfileLinks.Where(l => l.ProfileId == _profile.Id).ToListAsync();

        foreach (var l in _links)
        {
            var row = existing.FirstOrDefault(e => e.Id == l.Id);
            if (row != null)
            {
                row.SortOrder = l.SortOrder;
            }
        }

        await db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_user == null || _profile == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var existing = await db.ProfileLinks.Where(l => l.ProfileId == _profile.Id).ToListAsync();

        // Delete removed
        foreach (var e in existing)
        {
            if (!_links.Any(l => l.Id == e.Id))
            {
                db.ProfileLinks.Remove(e);
            }
        }

        // Upsert current
        foreach (var l in _links)
        {
            var row = existing.FirstOrDefault(e => e.Id == l.Id);
            if (row == null)
            {
                l.ProfileId = _profile.Id;
                db.ProfileLinks.Add(l);
            }
            else
            {
                row.Title = l.Title;
                row.Url = l.Url;
                row.IsVisible = l.IsVisible;
                row.SortOrder = l.SortOrder;
            }
        }

        await db.SaveChangesAsync();
        StateHasChanged();
    }

}
