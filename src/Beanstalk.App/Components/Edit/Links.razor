@page "/edit/links"
@rendermode InteractiveServer

@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using System.Text.RegularExpressions

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div @onclick="CloseMenuIfOutside">
            @if (_loading)
            {
                <p class="text-center text-gray-600 py-5">Loading links...</p>
            }
            else if (_profile is null || _user is null)
            {
                <div class="card-cute text-center py-5">
                    <p class="text-gray-600">Profile not found.</p>
                </div>
            }
            else
            {
                <!-- Breadcrumbs -->
                <nav class="mb-3" aria-label="Breadcrumb">
                    <ol class="d-flex align-items-center gap-2 small text-gray-600">
                        <li><a href="/edit/links" class="text-decoration-none text-gray-600 hover-text-gray-900">Links</a></li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h3 class="h4 fw-bold mb-2 text-gray-900">Links</h3>
                        <p class="small text-gray-600">Add and organize links for your profile page.</p>
                    </div>
                    <button class="btn-primary" @onclick="NavigateToCreate" disabled="@(_links.Count >= 20)">
                        Create New Link
                    </button>
                </div>

                <div class="d-flex flex-column gap-4">
                    <!-- Links List -->
                    @if (_links.Count == 0)
                    {
                        <div class="card-cute text-center py-5 bg-gray-50">
                            <h4 class="h5 fw-semibold text-gray-800 mb-2">No Links Yet</h4>
                            <p class="text-gray-600 mb-4">Add links to your social media, portfolio, or any other pages you want to share!</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < _links.Count; i++)
                            {
                                var link = _links[i];
                                var index = i;
                                var isValidUrl = !string.IsNullOrWhiteSpace(link.Url) && Uri.TryCreate(link.Url, UriKind.Absolute, out _);
                                
                                <div class="card-cute @(link.IsVisible ? "" : "opacity-50")">
                                    <div class="d-flex align-items-center gap-3">
                                        <!-- Up/Down Arrow Buttons -->
                                        <div class="d-flex flex-column flex-shrink-0" style="gap: 0.25rem;">
                                            <button class="btn btn-sm btn-link p-1 text-gray-400 hover-text-gray-600 text-decoration-none" style="transition: color 0.2s;"
                                                    @onclick="(() => MoveLinkUp(index))"
                                                    disabled="@(index == 0)">
                                                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                </svg>
                                            </button>
                                            <button class="btn btn-sm btn-link p-1 text-gray-400 hover-text-gray-600 text-decoration-none" style="transition: color 0.2s;"
                                                    @onclick="(() => MoveLinkDown(index))"
                                                    disabled="@(index == _links.Count - 1)">
                                                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                                </svg>
                                            </button>
                                        </div>

                                        <!-- Link Content -->
                                        <div class="flex-grow-1 d-flex align-items-center justify-content-between">
                                            <div class="flex-grow-1">
                                                @if (isValidUrl && !string.IsNullOrWhiteSpace(link.Title))
                                                {
                                                    <a href="@link.Url" target="_blank" rel="noopener" 
                                                       class="d-flex align-items-center gap-3 text-decoration-none hover-text-indigo-600" style="transition: color 0.2s;">
                                                        <span class="fw-semibold text-gray-800">@link.Title</span>
                                                        <span class="small text-gray-500 text-truncate" style="max-width: 28rem;">@link.Url</span>
                                                        @if (!link.IsVisible)
                                                        {
                                                            <span class="badge bg-gray-200 text-gray-600">Hidden</span>
                                                        }
                                                        <span class="text-gray-400">→</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center gap-3">
                                                        <span class="fw-semibold text-gray-400">@(string.IsNullOrWhiteSpace(link.Title) ? "Untitled Link" : link.Title)</span>
                                                        @if (!link.IsVisible)
                                                        {
                                                            <span class="badge bg-gray-200 text-gray-600">Hidden</span>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <!-- Three Dots Menu -->
                                            <div class="position-relative flex-shrink-0" @onclick:stopPropagation="true">
                                                <button class="btn btn-sm btn-link p-2 text-gray-400 hover-text-gray-600 hover-bg-gray-100 rounded text-decoration-none" style="transition: all 0.2s;"
                                                        @onclick="(() => ToggleMenu(link.Id))">
                                                    <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                                                    </svg>
                                                </button>

                                                @if (_openMenuId == link.Id)
                                                {
                                                    <div class="position-absolute end-0 mt-2 bg-white rounded shadow-lg border border-gray-200 py-1 z-50" style="width: 12rem;">
                                                        <button class="btn btn-link w-100 text-start px-3 py-2 small text-gray-700 hover-bg-gray-100 text-decoration-none" style="transition: background-color 0.2s;"
                                                                @onclick="(() => ToggleVisibility(link))">
                                                            @(link.IsVisible ? "Disable" : "Enable")
                                                        </button>
                                                        <button class="btn btn-link w-100 text-start px-3 py-2 small text-gray-700 hover-bg-gray-100 text-decoration-none" style="transition: background-color 0.2s;"
                                                                @onclick="(() => NavigateToEdit(link.Id))">
                                                            Edit
                                                        </button>
                                                        <button class="btn btn-link w-100 text-start px-3 py-2 small text-red-600 hover-bg-red-50 text-decoration-none" style="transition: background-color 0.2s;"
                                                                @onclick="(() => DeleteLink(link))">
                                                            Delete
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            </div>
        </Authorized>
        <NotAuthorized>
            <PleaseLogIn />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private ApplicationUser? _user;
    private UserProfile? _profile;
    private List<ProfileLink> _links = new();
    private bool _loading = true;
    private Guid? _openMenuId = null;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);
        if (_user != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            _profile = await db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == _user.Id);
            if (_profile != null)
            {
                _links = await db.ProfileLinks
                    .AsNoTracking()
                    .Where(l => l.ProfileId == _profile.Id)
                    .OrderBy(l => l.SortOrder)
                    .ToListAsync();
            }
        }

        _loading = false;
    }

    private async Task MoveLinkUp(int index)
    {
        if (index <= 0 || index >= _links.Count)
            return;

        // Swap with item above
        var temp = _links[index];
        _links[index] = _links[index - 1];
        _links[index - 1] = temp;

        Reindex();
        await SaveOrderAsync();
        StateHasChanged();
    }

    private async Task MoveLinkDown(int index)
    {
        if (index < 0 || index >= _links.Count - 1)
            return;

        // Swap with item below
        var temp = _links[index];
        _links[index] = _links[index + 1];
        _links[index + 1] = temp;

        Reindex();
        await SaveOrderAsync();
        StateHasChanged();
    }

    private void NavigateToCreate()
    {
        Nav.NavigateTo("/edit/links/create");
    }

    private void NavigateToEdit(Guid linkId)
    {
        _openMenuId = null;
        Nav.NavigateTo($"/edit/links/edit/{linkId}");
    }

    private void ToggleMenu(Guid linkId)
    {
        _openMenuId = _openMenuId == linkId ? null : linkId;
        StateHasChanged();
    }

    private void CloseMenuIfOutside()
    {
        if (_openMenuId != null)
        {
            _openMenuId = null;
            StateHasChanged();
        }
    }

    private async Task ToggleVisibility(ProfileLink link)
    {
        _openMenuId = null;
        link.IsVisible = !link.IsVisible;
        await SaveAsync();
    }

    private async Task DeleteLink(ProfileLink link)
    {
        _openMenuId = null;
        _links.Remove(link);
        Reindex();
        await SaveAsync();
    }

    private void Reindex()
    {
        for (int i = 0; i < _links.Count; i++)
        {
            _links[i].SortOrder = i;
        }
    }

    private async Task SaveOrderAsync()
    {
        if (_user == null || _profile == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var existing = await db.ProfileLinks.Where(l => l.ProfileId == _profile.Id).ToListAsync();

        foreach (var l in _links)
        {
            var row = existing.FirstOrDefault(e => e.Id == l.Id);
            if (row != null)
            {
                row.SortOrder = l.SortOrder;
            }
        }

        await db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_user == null || _profile == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var existing = await db.ProfileLinks.Where(l => l.ProfileId == _profile.Id).ToListAsync();

        // Delete removed
        foreach (var e in existing)
        {
            if (!_links.Any(l => l.Id == e.Id))
            {
                db.ProfileLinks.Remove(e);
            }
        }

        // Upsert current
        foreach (var l in _links)
        {
            var row = existing.FirstOrDefault(e => e.Id == l.Id);
            if (row == null)
            {
                l.ProfileId = _profile.Id;
                db.ProfileLinks.Add(l);
            }
            else
            {
                row.Title = l.Title;
                row.Url = l.Url;
                row.IsVisible = l.IsVisible;
                row.SortOrder = l.SortOrder;
            }
        }

        await db.SaveChangesAsync();
        StateHasChanged();
    }

}
