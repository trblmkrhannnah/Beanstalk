@page "/edit/appearance"
@rendermode InteractiveServer

@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading themes...</p>
            }
            else if (_profile is null || _user is null)
            {
                <div class="card-cute text-center py-12">
                    <p class="text-gray-600">Profile not found.</p>
                </div>
            }
            else
            {
                <h3 class="text-3xl font-bold mb-4 text-gray-900">Appearance</h3>
                <p class="text-gray-600 mb-8">Choose a beautiful color scheme for your profile page.</p>

                <div class="space-y-6">

                    @if (_palettes.Count == 0)
                    {
                        <div class="card-cute bg-yellow-50 border border-yellow-200">
                            <p class="text-yellow-800">
                                No palettes available. Please restart the application to seed default palettes.
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Theme Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            @foreach (var palette in _palettes)
                            {
                                var isSelected = _selectedPaletteId == palette.Id;
                                var gradientStyle = $"background: linear-gradient(135deg, {palette.BackgroundGradient1} 0%, {palette.BackgroundGradient2} 100%);";
                                
                                <div class="theme-card card-cute p-0 overflow-hidden cursor-pointer transition-all duration-200 @(isSelected ? "ring-2 ring-indigo-500" : "hover:shadow-lg")"
                                     @onclick="@(() => SelectPalette(palette.Id))">
                                    
                                    <!-- Preview Section -->
                                    <div class="h-32 relative" style="@gradientStyle">
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <div class="text-center text-white drop-shadow-lg">
                                                <div class="text-sm font-semibold opacity-90">Preview</div>
                                            </div>
                                        </div>
                                        
                                        <!-- Selection Badge -->
                                        @if (isSelected)
                                        {
                                            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm rounded-full px-3 py-1 flex items-center gap-2 shadow-lg">
                                                <span class="text-green-500 text-sm">✓</span>
                                                <span class="text-xs font-semibold text-gray-700">Selected</span>
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- Info Section -->
                                    <div class="p-5">
                                        <h4 class="text-lg font-semibold text-gray-800 mb-3">
                                            @palette.Name
                                            @if (palette.IsDefault)
                                            {
                                                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full font-semibold ml-2">Default</span>
                                            }
                                        </h4>
                                        
                                        <!-- Color Swatches -->
                                        <div class="space-y-2 mb-4">
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="text-gray-500 w-20">Background:</span>
                                                <div class="flex gap-1 flex-1">
                                                    <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.BackgroundGradient1;"></div>
                                                    <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.BackgroundGradient2;"></div>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="text-gray-500 w-20">Title:</span>
                                                <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.TitleColor;"></div>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="text-gray-500 w-20">Content:</span>
                                                <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.ContentColor;"></div>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="text-gray-500 w-20">Container:</span>
                                                <div class="flex gap-1 flex-1">
                                                    <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.ContainerBackground;"></div>
                                                    <div class="h-5 w-8 rounded border border-gray-200" style="background: @palette.ContainerForeground;"></div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Action Button -->
                                        <button class="w-full @(isSelected ? "bg-indigo-600 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200") rounded-lg py-2 font-medium transition-all duration-200">
                                            @(isSelected ? "Currently Selected" : "Select Theme")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Save Button -->
                        <div class="flex items-center gap-4">
                            <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@(!_selectedPaletteId.HasValue || _saved)">
                                Save Theme
                            </button>
                            @if (_saved)
                            {
                                <span class="text-green-600 font-medium">Theme saved successfully!</span>
                            }
                            else if (_selectedPaletteId.HasValue)
                            {
                                var selectedPalette = _palettes.FirstOrDefault(p => p.Id == _selectedPaletteId);
                                <span class="text-gray-600">Selected: <span class="font-medium">@(selectedPalette?.Name ?? "Unknown")</span></span>
                            }
                        </div>
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <PleaseLogIn />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private ApplicationUser? _user;
    private UserProfile? _profile;
    private List<ThemePalette> _palettes = new();
    private Guid? _selectedPaletteId;
    private bool _loading = true;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);
        if (_user != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            _profile = await db.UserProfiles
                .Include(p => p.ThemePalette)
                .FirstOrDefaultAsync(p => p.UserId == _user.Id);

            // Create profile if it doesn't exist
            if (_profile == null)
            {
                _profile = new UserProfile
                {
                    Id = Guid.NewGuid(),
                    UserId = _user.Id,
                    CreatedUtc = DateTime.UtcNow
                };
                db.UserProfiles.Add(_profile);
                await db.SaveChangesAsync();
                
                // Re-fetch with AsNoTracking after saving
                _profile = await db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.Id == _profile.Id);
            }

            _selectedPaletteId = _profile.ThemePaletteId;
            
            _palettes = await db.ThemePalettes.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
        }

        _loading = false;
    }

    private void SelectPalette(Guid paletteId)
    {
        _selectedPaletteId = paletteId;
        _saved = false;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_profile == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var profileToUpdate = await db.UserProfiles.FindAsync(_profile.Id);
        if (profileToUpdate != null)
        {
            profileToUpdate.ThemePaletteId = _selectedPaletteId;
            await db.SaveChangesAsync();
        }
        
        _saved = true;
        StateHasChanged();
    }

    private string GetThemeEmoji(string themeName)
    {
        return themeName switch
        {
            "Ocean Breeze" => "🌊",
            "Sunset Glow" => "🌅",
            "Forest Deep" => "🌲",
            "Midnight Sky" => "🌙",
            "Cherry Blossom" => "🌸",
            "Arctic Ice" => "❄️",
            "Desert Sand" => "🏜️",
            "Neon Nights" => "🌃",
            "Autumn Harvest" => "🍂",
            "Monochrome" => "⚫",
            _ => "🎨"
        };
    }
}
