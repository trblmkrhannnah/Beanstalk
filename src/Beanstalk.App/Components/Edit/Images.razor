@page "/edit/images"
@rendermode InteractiveServer

@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using Microsoft.Extensions.DependencyInjection
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading images...</p>
            }
            else if (_profile is null)
            {
                <div class="card-cute text-center py-12">
                    <p class="text-gray-600">Profile not found.</p>
                </div>
            }
            else
            {
                <h3 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4 text-gray-900">Images</h3>
                <p class="text-sm sm:text-base text-gray-600 mb-6 sm:mb-8">Manage your profile images.</p>

                <div class="space-y-6">
                    <!-- Stats Card -->
                    <div class="card-cute mb-6">
                        <div class="flex items-center justify-between mb-3 sm:mb-4">
                            <h4 class="text-lg sm:text-xl font-semibold text-gray-800">Image Storage</h4>
                            <span class="text-sm sm:text-base text-gray-600">@_images.Count / @_maxImages</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                            <div class="bg-indigo-600 h-2.5 rounded-full transition-all duration-300" 
                                 style="width: @((_images.Count / (double)_maxImages) * 100)%"></div>
                        </div>
                        @if (_images.Count >= _maxImages)
                        {
                            <p class="text-red-500 text-sm mt-3">You have reached the maximum number of images allowed. Please delete existing images to upload new ones.</p>
                        }
                    </div>

                    <!-- Images Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                        <!-- Add Image Placeholder Card (Always First) -->
                        @if (_images.Count < _maxImages)
                        {
                            <div class="card-cute p-0 overflow-hidden cursor-pointer hover:ring-2 hover:ring-indigo-500 transition-all" 
                                 @onclick="ShowUploadModal">
                                <div class="relative aspect-square bg-gray-100 flex items-center justify-center">
                                    <div class="text-center p-4">
                                        <div class="text-4xl text-gray-400 mb-2">+</div>
                                        <div class="text-sm font-medium text-gray-600">Add Image</div>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @foreach (var img in _images)
                        {
                            var isDefault = _profile.SelectedImageId == img.Id;
                            <div class="group relative card-cute p-0 overflow-hidden @(isDefault ? "ring-2 ring-indigo-500" : "")">
                                <!-- Image -->
                                <div class="relative aspect-square bg-gray-100">
                                    <img src="/api/images/@img.Id" 
                                         alt="Profile Image" 
                                         class="w-full h-full object-cover" />
                                    
                                    <!-- Default Badge -->
                                    @if (isDefault)
                                    {
                                        <div class="absolute top-2 right-2 bg-green-500 text-white px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1 shadow-lg">
                                            <span>✓</span> Default
                                        </div>
                                    }
                                    
                                    <!-- Overlay on Hover -->
                                    <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-2">
                                        @if (!isDefault)
                                        {
                                            <button class="px-4 py-2 bg-white text-gray-800 rounded-lg font-semibold hover:bg-gray-100 transition-colors text-sm" 
                                                    @onclick="(() => SetAsDefault(img.Id))">
                                                Set Default
                                            </button>
                                        }
                                        <button class="px-4 py-2 bg-red-500 text-white rounded-lg font-semibold hover:bg-red-600 transition-colors text-sm" 
                                                @onclick="(() => DeleteImage(img.Id))">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Image Info -->
                                <div class="p-3 bg-white">
                                    <div class="text-xs text-gray-500">
                                        @img.CreatedUtc.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Upload Modal -->
            @if (_showUploadModal)
            {
                <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm" @onclick="CloseUploadModal">
                    <div class="card-cute max-w-2xl w-full max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
                        <div class="flex items-center justify-between mb-4 sm:mb-6">
                            <h4 class="text-xl sm:text-2xl font-semibold text-gray-800">Upload Profile Image</h4>
                            <button class="text-gray-400 hover:text-gray-600 text-2xl font-bold w-8 h-8 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors" 
                                    @onclick="CloseUploadModal">
                                ×
                            </button>
                        </div>

                        @if (_uploadError != null)
                        {
                            <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                                @_uploadError
                            </div>
                        }

                        <div class="space-y-4">
                            <div>
                                <label for="imageFile" class="block text-sm font-medium text-gray-700 mb-2">
                                    Select an Image
                                </label>
                                <div class="relative">
                                    <input type="file" 
                                           id="imageFile" 
                                           class="input-cute cursor-pointer" 
                                           accept="image/jpeg,image/png,image/webp" 
                                           onchange="handleImageFileSelected(this)" />
                                </div>
                                <small class="block mt-2 text-sm text-gray-500">
                                    Supported formats: JPEG, PNG, WebP • Maximum size: 10MB
                                </small>
                            </div>

                            <div id="cropperContainer" 
                                 class="hidden mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                                <p class="text-sm font-medium text-gray-700 mb-3">
                                    Crop your image to a square (1024x1024px recommended):
                                </p>
                                <div class="relative bg-white rounded-lg overflow-hidden shadow-inner">
                                    <img id="cropperImage" class="max-w-full" />
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-3 mt-6 pt-6 border-t border-gray-200">
                            <button type="button" class="btn-secondary flex-1" @onclick="CloseUploadModal">
                                Cancel
                            </button>
                            <button type="button" 
                                    id="saveUploadBtn" 
                                    class="btn-primary flex-1 hidden" 
                                    onclick="saveAndUploadImage()">
                                <span id="uploadBtnText">Save & Upload</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <PleaseLogIn />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private UserProfile? _profile;
    private List<Image> _images = new();
    private bool _loading = true;
    private int _maxImages = 10;
    
    private bool _showUploadModal = false;
    private string? _uploadError;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        
        // Get user ID directly from claims instead of using UserManager
        var userIdClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userIdClaim) && Guid.TryParse(userIdClaim, out var userId))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            _profile = await db.UserProfiles
                .AsNoTracking()
                .Include(p => p.Images)
                .FirstOrDefaultAsync(p => p.UserId == userId);
            
            if (_profile != null)
            {
                _images = _profile.Images.OrderByDescending(i => i.CreatedUtc).ToList();
            }
            
            var maxImagesSetting = await db.AppSettings
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.Key == "MaxImagesPerUser");
            
            if (maxImagesSetting != null && int.TryParse(maxImagesSetting.Value, out var parsedMax))
            {
                _maxImages = parsedMax;
            }
        }
        _loading = false;
    }

    private void ShowUploadModal()
    {
        _showUploadModal = true;
        _uploadError = null;
        StateHasChanged();
    }

    private async Task CloseUploadModal()
    {
        _showUploadModal = false;
        _uploadError = null;
        await JS.InvokeVoidAsync("resetUploadModal");
        StateHasChanged();
    }

    private async Task SetAsDefault(Guid imageId)
    {
        try
        {
            await JS.InvokeVoidAsync("fetch", $"/api/images/{imageId}/set-default", new
            {
                method = "POST",
                credentials = "include"
            });
            
            // Reload to update UI
            Nav.NavigateTo("/edit/images", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting default: {ex.Message}");
        }
    }

    private async Task DeleteImage(Guid imageId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this image? This action cannot be undone."))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("fetch", $"/api/images/{imageId}", new
            {
                method = "DELETE",
                credentials = "include"
            });
            
            // Reload to update UI
            Nav.NavigateTo("/edit/images", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting image: {ex.Message}");
        }
    }
}
