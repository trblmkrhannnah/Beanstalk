@page "/edit/settings"
@rendermode InteractiveServer

@using Beanstalk.App.Components.Common
@using Beanstalk.App.Features

@inject BeanstalkConfig Config

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <h3>Settings</h3>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="regsOpen" @bind="_registrationsOpen"/>
                <label class="form-check-label" for="regsOpen">Registrations Open</label>
            </div>
            <div class="mb-3 mt-3">
                <label for="maxImages" class="form-label">Max Images Per User</label>
                <input type="number" class="form-control" id="maxImages" @bind="_maxImagesPerUser" min="1" max="100"/>
                <small class="text-muted">Maximum number of profile images each user can upload (default: 10)</small>
            </div>
            <button class="btn btn-primary mt-2" @onclick="SaveAsync">Save</button>
            @if (_saved)
            {
                <div>Saved.</div>
            }
        </Authorized>
        <NotAuthorized>
            <NotAuthorised />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private bool _registrationsOpen = true;
    private int _maxImagesPerUser = 10;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        _registrationsOpen = await Config.RegistrationsEnabled.Get();
        _maxImagesPerUser = await Config.MaxImagesPerUser.Get();
    }

    private async Task SaveAsync()
    {
        await Config.RegistrationsEnabled.Set(_registrationsOpen);
        await Config.MaxImagesPerUser.Set(_maxImagesPerUser);
        
        _saved = true;
    }

}



