@page "/edit/"
@page "/edit/dashboard"
@* @rendermode InteractiveServer *@

@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView Context="auth">
    <Authorized>
        @if (_loading)
        {
            <p class="text-center text-gray-600 text-lg py-12">Loading dashboard...</p>
        }
        else if (Model is null || _user is null)
        {
            <div class="card-cute text-center py-12">
                <p class="text-gray-600">Profile not found.</p>
            </div>
        }
        else
        {
            <h3 class="text-3xl font-bold mb-4 text-gray-900">Dashboard</h3>
            <p class="text-gray-600 mb-8">Welcome back! Here's what's happening with your profile.</p>

            <div class="space-y-6">

                <!-- Quick Stats -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="stat-card">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-gray-500">Total Views</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-100 px-2 py-1 rounded-full">+12%</span>
                        </div>
                        <div class="text-3xl font-bold text-gray-800 mb-1">@_analytics.TotalViews</div>
                    </div>

                    <div class="stat-card">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-gray-500">Unique Visitors</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-100 px-2 py-1 rounded-full">+8%</span>
                        </div>
                        <div class="text-3xl font-bold text-gray-800 mb-1">@_analytics.UniqueVisitors</div>
                    </div>

                    <div class="stat-card">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-gray-500">Link Clicks</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-100 px-2 py-1 rounded-full">+5%</span>
                        </div>
                        <div class="text-3xl font-bold text-gray-800 mb-1">@_analytics.LinkClicks</div>
                    </div>

                    <div class="stat-card">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-gray-500">Avg. Time (min)</span>
                            <span class="text-xs font-semibold text-green-600 bg-green-100 px-2 py-1 rounded-full">+3%</span>
                        </div>
                        <div class="text-3xl font-bold text-gray-800 mb-1">@_analytics.AvgTimeOnPage</div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Views Over Time -->
                    <div class="card-cute">
                        <h4 class="text-xl font-semibold text-gray-800 mb-4">Views Over Time</h4>
                        <div class="h-64 flex items-end justify-between gap-2">
                            @foreach (var day in _analytics.DailyViews)
                            {
                                var height = (day.Value / (double)_analytics.DailyViews.Max(d => d.Value)) * 100;
                                <div class="flex-1 flex flex-col items-center">
                                    <div class="w-full bg-indigo-500 rounded-t-lg hover:bg-indigo-600 transition-all duration-300 cursor-pointer" 
                                         style="height: @(height)%"
                                         title="@day.Key: @day.Value views">
                                    </div>
                                    <span class="text-xs text-gray-500 mt-2">@day.Key</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Top Referrers -->
                    <div class="card-cute">
                        <h4 class="text-xl font-semibold text-gray-800 mb-4">Top Referrers</h4>
                        <div class="space-y-3">
                            @foreach (var referrer in _analytics.TopReferrers)
                            {
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <div class="font-semibold text-gray-800">@referrer.Source</div>
                                            <div class="text-xs text-gray-500">@referrer.Count visits</div>
                                        </div>
                                    </div>
                                    <div class="text-indigo-600 font-bold">@referrer.Percentage%</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Recent Activity & Quick Actions -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Recent Activity -->
                    <div class="card-cute">
                        <h4 class="text-xl font-semibold text-gray-800 mb-4">Recent Activity</h4>
                        <div class="space-y-3">
                            @foreach (var activity in _analytics.RecentActivity)
                            {
                                <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                                    <div class="flex-1">
                                        <div class="font-medium text-gray-800">@activity.Description</div>
                                        <div class="text-xs text-gray-500">@activity.TimeAgo</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="card-cute">
                        <h4 class="text-xl font-semibold text-gray-800 mb-4">Quick Actions</h4>
                        <div class="space-y-3">
                            <a href="/edit/appearance" class="w-full btn-secondary text-left flex items-center justify-between block">
                                <span>Customize Appearance</span>
                                <span>→</span>
                            </a>
                            <a href="/edit/links" class="w-full btn-secondary text-left flex items-center justify-between block">
                                <span>Manage Links</span>
                                <span>→</span>
                            </a>
                            <a href="/edit/images" class="w-full btn-secondary text-left flex items-center justify-between block">
                                <span>Update Images</span>
                                <span>→</span>
                            </a>
                            @if (!string.IsNullOrEmpty(_username))
                            {
                                <a href="/@_username" target="_blank" class="w-full btn-secondary text-left flex items-center justify-between block">
                                    <span>View Profile</span>
                                    <span>→</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Profile Settings (Collapsible) -->
                <details class="card-cute">
                    <summary class="cursor-pointer text-xl font-semibold text-gray-800 mb-4 flex items-center list-none">
                        Profile Settings
                        <span class="ml-auto text-sm font-normal text-gray-500">Click to expand</span>
                    </summary>
                    <div class="pt-4 border-t border-gray-200">
                        <EditForm Model="Model" OnValidSubmit="SaveAsync" FormName="dashboard" method="post" class="space-y-4">
                            <DataAnnotationsValidator/>
                            <ValidationSummary class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"/>
                            <div class="flex items-center p-4 bg-gray-50 rounded-lg border border-gray-200">
                                <InputCheckbox class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500" id="enabled" @bind-Value="Model.UserEnabled"/>
                                <label class="ml-3 text-sm font-medium text-gray-700 cursor-pointer" for="enabled">Enable my profile page</label>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Display Name</label>
                                <InputText class="input-cute" @bind-Value="Model.DisplayName" placeholder="Your display name"/>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Bio</label>
                                <InputTextArea class="input-cute min-h-[100px]" @bind-Value="Model.Bio" placeholder="Tell visitors about yourself..."/>
                            </div>
                            <div class="flex items-center gap-3">
                                <button class="btn-primary" type="submit">Save Changes</button>
                                @if (_saved)
                                {
                                    <span class="text-green-600 font-medium">Saved successfully!</span>
                                }
                            </div>
                        </EditForm>
                    </div>
                </details>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <PleaseLogIn />
    </NotAuthorized>
</AuthorizeView>

@code {
    private ApplicationUser? _user;
    [SupplyParameterFromForm] private DashboardModel? Model { get; set; }
    private bool _loading = true;
    private bool _saved;
    private string? _username;
    private AnalyticsData _analytics = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _saved = false;
        
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);

        if (_user != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            var profile = await db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == _user.Id);
            _username = _user.UserName;

            if (Model == null)
            {
                Model = new();
                
                Model.UserEnabled = _user.IsEnabled;
                Model.DisplayName = profile?.DisplayName;
                Model.Bio = profile?.Bio;
            }
            
            // Generate mock analytics data
            _analytics = GenerateMockAnalytics();
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_user == null)
            return;

        // Update user enabled status
        var userToUpdate = await UserManager.FindByIdAsync(_user.Id.ToString());
        if (userToUpdate != null)
        {
            userToUpdate.IsEnabled = Model.UserEnabled;
            await UserManager.UpdateAsync(userToUpdate);
            
            // Update our local reference
            _user.IsEnabled = Model.UserEnabled;
        }
        
        // Update profile
        await using var db = await DbFactory.CreateDbContextAsync();
        var profile = await db.UserProfiles.FirstOrDefaultAsync(p => p.UserId == _user.Id);
        
        if (profile == null)
        {
            profile = new UserProfile { Id = Guid.NewGuid(), UserId = _user.Id, CreatedUtc = DateTime.UtcNow };
            db.UserProfiles.Add(profile);
        }

        profile.DisplayName = Model.DisplayName;
        profile.Bio = Model.Bio;
        await db.SaveChangesAsync();
        
        // Refresh local reference
        _saved = true;
    }

    private AnalyticsData GenerateMockAnalytics()
    {
        var random = new Random();
        var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
        
        return new AnalyticsData
        {
            TotalViews = 1247 + random.Next(0, 500),
            UniqueVisitors = 892 + random.Next(0, 300),
            LinkClicks = 342 + random.Next(0, 100),
            AvgTimeOnPage = 3 + random.Next(0, 5),
            DailyViews = days.Select(d => new KeyValuePair<string, int>(d, random.Next(50, 200))).ToList(),
            TopReferrers = new List<ReferrerData>
            {
                new() { Source = "Direct", Icon = "🔍", Count = 456, Percentage = 42 },
                new() { Source = "Social Media", Icon = "📱", Count = 312, Percentage = 29 },
                new() { Source = "Search Engines", Icon = "🔎", Count = 234, Percentage = 22 },
                new() { Source = "Other", Icon = "🌐", Count = 87, Percentage = 7 }
            },
            RecentActivity = new List<ActivityData>
            {
                new() { Icon = "👀", Description = "New visitor from United States", TimeAgo = "2 minutes ago" },
                new() { Icon = "🔗", Description = "Link clicked: Portfolio", TimeAgo = "15 minutes ago" },
                new() { Icon = "👀", Description = "New visitor from Canada", TimeAgo = "1 hour ago" },
                new() { Icon = "⭐", Description = "Profile viewed for 5+ minutes", TimeAgo = "2 hours ago" },
                new() { Icon = "🔗", Description = "Link clicked: GitHub", TimeAgo = "3 hours ago" }
            }
        };
    }

    private class DashboardModel
    {
        public bool UserEnabled { get; set; }
        public string? DisplayName { get; set; }
        public string? Bio { get; set; }
    }

    private class AnalyticsData
    {
        public int TotalViews { get; set; }
        public int UniqueVisitors { get; set; }
        public int LinkClicks { get; set; }
        public int AvgTimeOnPage { get; set; }
        public List<KeyValuePair<string, int>> DailyViews { get; set; } = new();
        public List<ReferrerData> TopReferrers { get; set; } = new();
        public List<ActivityData> RecentActivity { get; set; } = new();
    }

    private class ReferrerData
    {
        public string Source { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public int Count { get; set; }
        public int Percentage { get; set; }
    }

    private class ActivityData
    {
        public string Icon { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string TimeAgo { get; set; } = string.Empty;
    }
}
