@page "/edit/manage-user/{userId:guid}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Entities
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole<Guid>> RoleManager
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (_loading)
            {
                <p>Loading...</p>
            }
            else if (_managedUser == null)
            {
                <div class="alert alert-danger">User not found.</div>
                <a href="/edit/users" class="btn btn-secondary">Back to Users</a>
            }
            else
            {
                <div class="mb-3">
                    <a href="/edit/users" class="btn btn-secondary btn-sm">← Back to Users</a>
                </div>

                <h3>Manage User: @_managedUser.UserName</h3>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") mt-3" role="alert">
                        @_message
                    </div>
                }

                <!-- User Information -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">User Information</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Username</dt>
                            <dd class="col-sm-9">@_managedUser.UserName</dd>

                            <dt class="col-sm-3">User ID</dt>
                            <dd class="col-sm-9"><code>@_managedUser.Id</code></dd>

                            <dt class="col-sm-3">Role</dt>
                            <dd class="col-sm-9">
                                @if (_isAdmin)
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                @if (_managedUser.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Disabled</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Two-Factor Authentication -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Two-Factor Authentication</h5>
                        
                        <dl class="row mb-3">
                            <dt class="col-sm-3">2FA Status</dt>
                            <dd class="col-sm-9">
                                @if (_twoFactorEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </dd>
                        </dl>

                        @if (_twoFactorEnabled)
                        {
                            @if (!_showResetConfirmation)
                            {
                                <button class="btn btn-warning" type="button" @onclick="ShowResetConfirmation">
                                    Reset Two-Factor Authentication
                                </button>
                                <p class="text-muted small mt-2 mb-0">
                                    This will disable 2FA for this user and clear their authenticator settings. The user will need to set up 2FA again if they wish to re-enable it.
                                </p>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <strong>Confirm Reset:</strong> Are you sure you want to reset two-factor authentication for @_managedUser.UserName? This action cannot be undone.
                                </div>
                                <button class="btn btn-danger me-2" type="button" @onclick="ResetTwoFactorAsync">
                                    Yes, Reset 2FA
                                </button>
                                <button class="btn btn-secondary" type="button" @onclick="CancelReset">
                                    Cancel
                                </button>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">This user does not have two-factor authentication enabled.</p>
                        }
                    </div>
                </div>

                <!-- Password Reset -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Password Management</h5>
                        
                        @if (!_showPasswordReset)
                        {
                            <p class="text-muted">Reset the user's password to a new value.</p>
                            <button class="btn btn-warning" type="button" @onclick="ShowPasswordReset">
                                Reset Password
                            </button>
                        }
                        else
                        {
                            <EditForm Model="PasswordResetModel" OnValidSubmit="ResetPasswordAsync" Context="passwordForm">
                                <DataAnnotationsValidator/>
                                <ValidationSummary/>
                                
                                @if (!string.IsNullOrEmpty(_passwordResetError))
                                {
                                    <div class="alert alert-danger">@_passwordResetError</div>
                                }
                                
                                @if (_passwordResetSuccess)
                                {
                                    <div class="alert alert-success">
                                        <strong>Password reset successfully!</strong> The user can now log in with the new password.
                                    </div>
                                }
                                
                                <div class="mb-3">
                                    <label for="new-password" class="form-label">New Password</label>
                                    <InputText id="new-password" type="password" class="form-control" @bind-Value="PasswordResetModel.NewPassword"/>
                                    <small class="form-text text-muted">Password must be at least 6 characters long.</small>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="confirm-password" class="form-label">Confirm New Password</label>
                                    <InputText id="confirm-password" type="password" class="form-control" @bind-Value="PasswordResetModel.ConfirmPassword"/>
                                </div>
                                
                                <button class="btn btn-warning me-2" type="submit">Reset Password</button>
                                <button class="btn btn-secondary" type="button" @onclick="CancelPasswordReset">Cancel</button>
                            </EditForm>
                        }
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <NotAuthorised />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private ApplicationUser? _managedUser;
    private bool _loading = true;
    private bool _isAdmin;
    private bool _twoFactorEnabled;
    private string? _message;
    private bool _messageIsError;
    private bool _showResetConfirmation;
    private bool _showPasswordReset;
    private string? _passwordResetError;
    private bool _passwordResetSuccess;
    
    private ResetPasswordModel PasswordResetModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        _loading = true;
        _message = null;
        _showResetConfirmation = false;
        _showPasswordReset = false;
        _passwordResetError = null;
        _passwordResetSuccess = false;

        _managedUser = await UserManager.FindByIdAsync(UserId.ToString());

        if (_managedUser != null)
        {
            var roles = await UserManager.GetRolesAsync(_managedUser);
            _isAdmin = roles.Contains("Admin");
            _twoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(_managedUser);
        }

        _loading = false;
    }

    private void ShowResetConfirmation()
    {
        _showResetConfirmation = true;
        _message = null;
    }

    private void CancelReset()
    {
        _showResetConfirmation = false;
    }

    private async Task ResetTwoFactorAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            // Disable 2FA
            await UserManager.SetTwoFactorEnabledAsync(_managedUser, false);
            
            // Reset the authenticator key
            await UserManager.ResetAuthenticatorKeyAsync(_managedUser);

            _twoFactorEnabled = false;
            _showResetConfirmation = false;
            _message = $"Two-factor authentication has been reset for user '{_managedUser.UserName}'. The user will need to set up 2FA again if they wish to re-enable it.";
            _messageIsError = false;
        }
        catch (Exception)
        {
            _message = "An error occurred while resetting two-factor authentication. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private void ShowPasswordReset()
    {
        _showPasswordReset = true;
        _passwordResetError = null;
        _passwordResetSuccess = false;
        PasswordResetModel = new();
    }

    private void CancelPasswordReset()
    {
        _showPasswordReset = false;
        _passwordResetError = null;
        _passwordResetSuccess = false;
        PasswordResetModel = new();
    }

    private async Task ResetPasswordAsync()
    {
        if (_managedUser == null)
        {
            _passwordResetError = "User not found.";
            return;
        }

        if (PasswordResetModel.NewPassword != PasswordResetModel.ConfirmPassword)
        {
            _passwordResetError = "Passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(PasswordResetModel.NewPassword) || PasswordResetModel.NewPassword.Length < 6)
        {
            _passwordResetError = "Password must be at least 6 characters long.";
            return;
        }

        try
        {
            // Remove the existing password
            var removePasswordResult = await UserManager.RemovePasswordAsync(_managedUser);
            
            if (!removePasswordResult.Succeeded)
            {
                _passwordResetError = $"Failed to reset password: {string.Join("; ", removePasswordResult.Errors.Select(e => e.Description))}";
                return;
            }

            // Add the new password
            var addPasswordResult = await UserManager.AddPasswordAsync(_managedUser, PasswordResetModel.NewPassword);
            
            if (!addPasswordResult.Succeeded)
            {
                _passwordResetError = $"Failed to set new password: {string.Join("; ", addPasswordResult.Errors.Select(e => e.Description))}";
                return;
            }

            _passwordResetSuccess = true;
            _passwordResetError = null;
            _message = $"Password has been reset for user '{_managedUser.UserName}'.";
            _messageIsError = false;
            PasswordResetModel = new();
        }
        catch (Exception ex)
        {
            _passwordResetError = $"An error occurred while resetting the password: {ex.Message}";
        }

        StateHasChanged();
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required")]
        [StringLength(100, ErrorMessage = "Password must be at least {2} characters long.", MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password confirmation is required")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

