@page "/edit/manage-user/{userId:guid}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Entities
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole<Guid>> RoleManager
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading...</p>
            }
            else if (_managedUser == null)
            {
                <div class="p-4 bg-red-50 border-2 border-red-200 text-red-700 rounded-2xl mb-6">User not found.</div>
                <a href="/edit/users" class="btn-secondary">← Back to Users</a>
            }
            else
            {
                <div class="mb-6">
                    <a href="/edit/users" class="btn-secondary">← Back to Users</a>
                </div>

                <h3 class="text-3xl font-bold mb-8 text-gray-900">Manage User: @_managedUser.UserName</h3>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="p-4 @(_messageIsError ? "bg-red-50 border-2 border-red-200 text-red-700" : "bg-green-50 border-2 border-green-200 text-green-700") rounded-2xl mb-6" role="alert">
                        @_message
                    </div>
                }

                <!-- User Information -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">User Information</h5>
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-3">
                        <dt class="font-medium text-gray-700">Username</dt>
                        <dd class="sm:col-span-2 text-gray-900">@_managedUser.UserName</dd>

                        <dt class="font-medium text-gray-700">User ID</dt>
                        <dd class="sm:col-span-2"><code class="px-2 py-1 bg-gray-100 rounded text-sm">@_managedUser.Id</code></dd>
                    </dl>
                </div>

                <!-- Role Management -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">Role Management</h5>
                    
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-3 mb-4">
                        <dt class="font-medium text-gray-700">Current Role</dt>
                        <dd class="sm:col-span-2">
                            @if (_isAdmin)
                            {
                                <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold">Admin</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-semibold">User</span>
                            }
                        </dd>
                    </dl>

                    @if (_isSelfManagement)
                    {
                        <p class="text-gray-600 text-sm mb-0">You cannot change your own role.</p>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 mb-4">
                            <label class="text-sm font-medium text-gray-700">Change Role:</label>
                            <select class="input-cute text-sm w-40" @bind="_selectedRole">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="ChangeRoleAsync">
                            Change Role
                        </button>
                        <p class="text-gray-600 text-sm mt-2 mb-0">
                            Admin users have full access to manage all users, settings, and invite links.
                        </p>
                    }
                </div>

                <!-- Account Access -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">Account Access</h5>
                    
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-3 mb-4">
                        <dt class="font-medium text-gray-700">Account Status</dt>
                        <dd class="sm:col-span-2">
                            @if (_isLocked)
                            {
                                <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-semibold">Locked</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">Active</span>
                            }
                        </dd>
                    </dl>

                    @if (!_showLockConfirmation && !_showUnlockOptions)
                    {
                        @if (_isLocked)
                        {
                            <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="ShowUnlockOptions">
                                Unlock Account
                            </button>
                            <p class="text-gray-600 text-sm mt-2 mb-0">
                                This account is currently locked and cannot log in. Unlock to restore access.
                            </p>
                        }
                        else
                        {
                            <button class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition-colors" type="button" @onclick="ShowLockConfirmation">
                                Lock Account
                            </button>
                            <p class="text-gray-600 text-sm mt-2 mb-0">
                                Locking will prevent this user from logging in and will automatically unpublish their profile.
                            </p>
                        }
                    }
                    else if (_showLockConfirmation)
                    {
                        <div class="p-4 bg-orange-50 border-2 border-orange-200 rounded-2xl mb-4">
                            <strong class="text-orange-800">Confirm Lock:</strong> 
                            <span class="text-orange-700">Are you sure you want to lock the account for @_managedUser.UserName? This will prevent them from logging in and unpublish their profile.</span>
                        </div>
                        <div class="flex gap-2">
                            <button class="px-4 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-colors" type="button" @onclick="LockAccountAsync">
                                Yes, Lock Account
                            </button>
                            <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition-colors" type="button" @onclick="CancelLockUnlock">
                                Cancel
                            </button>
                        </div>
                    }
                    else if (_showUnlockOptions)
                    {
                        <div class="p-4 bg-blue-50 border-2 border-blue-200 rounded-2xl mb-4">
                            <strong class="text-blue-800">Unlock Account:</strong> 
                            <span class="text-blue-700">Would you like to also publish their profile when unlocking?</span>
                        </div>
                        <div class="flex items-center gap-2 mb-4">
                            <input type="checkbox" id="publish-on-unlock" class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500" @bind="_publishOnUnlock"/>
                            <label for="publish-on-unlock" class="text-sm font-medium text-gray-700 cursor-pointer">
                                Publish profile when unlocking
                            </label>
                        </div>
                        <div class="flex gap-2">
                            <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="UnlockAccountAsync">
                                Unlock Account
                            </button>
                            <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition-colors" type="button" @onclick="CancelLockUnlock">
                                Cancel
                            </button>
                        </div>
                    }
                </div>

                <!-- Profile Visibility -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">Profile Visibility</h5>
                    
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-3 mb-4">
                        <dt class="font-medium text-gray-700">Profile Status</dt>
                        <dd class="sm:col-span-2">
                            @if (_isPublished)
                            {
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">Published</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-semibold">Unpublished</span>
                            }
                        </dd>
                    </dl>

                    @if (_isLocked)
                    {
                        <p class="text-gray-600 text-sm mb-0">
                            This user's account is locked. The profile cannot be published while the account is locked.
                        </p>
                    }
                    else
                    {
                        <div class="flex gap-2">
                            @if (_isPublished)
                            {
                                <button class="px-4 py-2 bg-orange-500 text-white rounded-lg font-semibold hover:bg-orange-600 transition-colors" type="button" @onclick="UnpublishProfileAsync">
                                    Unpublish Profile
                                </button>
                            }
                            else
                            {
                                <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="PublishProfileAsync">
                                    Publish Profile
                                </button>
                            }
                        </div>
                        <p class="text-gray-600 text-sm mt-2 mb-0">
                            @if (_isPublished)
                            {
                                <span>This user's profile is visible to the public. Unpublish to hide it.</span>
                            }
                            else
                            {
                                <span>This user's profile is hidden from the public. Publish to make it visible.</span>
                            }
                        </p>
                    }
                </div>

                <!-- Two-Factor Authentication -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">Two-Factor Authentication</h5>
                    
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-3 mb-4">
                        <dt class="font-medium text-gray-700">2FA Status</dt>
                        <dd class="sm:col-span-2">
                            @if (_twoFactorEnabled)
                            {
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">Enabled</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-semibold">Disabled</span>
                            }
                        </dd>
                    </dl>

                    @if (_twoFactorEnabled)
                    {
                        @if (!_showResetConfirmation)
                        {
                            <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="ShowResetConfirmation">
                                Reset Two-Factor Authentication
                            </button>
                            <p class="text-gray-600 text-sm mt-2 mb-0">
                                This will disable 2FA for this user and clear their authenticator settings. The user will need to set up 2FA again if they wish to re-enable it.
                            </p>
                        }
                        else
                        {
                            <div class="p-4 bg-orange-50 border-2 border-orange-200 rounded-2xl mb-4">
                                <strong class="text-orange-800">Confirm Reset:</strong> 
                                <span class="text-orange-700">Are you sure you want to reset two-factor authentication for @_managedUser.UserName? This action cannot be undone.</span>
                            </div>
                            <div class="flex gap-2">
                                <button class="px-4 py-2 bg-orange-500 text-white rounded-lg font-semibold hover:bg-orange-600 transition-colors" type="button" @onclick="ResetTwoFactorAsync">
                                    Yes, Reset 2FA
                                </button>
                                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition-colors" type="button" @onclick="CancelReset">
                                    Cancel
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-gray-600 text-sm mb-0">This user does not have two-factor authentication enabled.</p>
                    }
                </div>

                <!-- Password Reset -->
                <div class="card-cute mb-6">
                    <h5 class="text-xl font-semibold mb-4 text-gray-800">Password Management</h5>
                    
                    @if (!_showPasswordReset)
                    {
                        <p class="text-gray-600 mb-4">Reset the user's password to a new value.</p>
                        <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors" type="button" @onclick="ShowPasswordReset">
                            Reset Password
                        </button>
                    }
                    else
                    {
                        <EditForm Model="PasswordResetModel" OnValidSubmit="ResetPasswordAsync" Context="passwordForm" class="space-y-4">
                            <DataAnnotationsValidator/>
                            <ValidationSummary class="p-4 bg-red-50 border-2 border-red-200 rounded-2xl text-red-700"/>
                            
                            @if (!string.IsNullOrEmpty(_passwordResetError))
                            {
                                <div class="p-4 bg-red-50 border-2 border-red-200 rounded-2xl text-red-700">@_passwordResetError</div>
                            }
                            
                            @if (_passwordResetSuccess)
                            {
                                <div class="p-4 bg-green-50 border-2 border-green-200 rounded-2xl text-green-700">
                                    <strong>Password reset successfully!</strong> The user can now log in with the new password.
                                </div>
                            }
                            
                            <div>
                                <label for="new-password" class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                                <InputText id="new-password" type="password" class="input-cute" @bind-Value="PasswordResetModel.NewPassword"/>
                                <small class="text-gray-600 text-sm">Password must be at least 6 characters long.</small>
                            </div>
                            
                            <div>
                                <label for="confirm-password" class="block text-sm font-medium text-gray-700 mb-2">Confirm New Password</label>
                                <InputText id="confirm-password" type="password" class="input-cute" @bind-Value="PasswordResetModel.ConfirmPassword"/>
                            </div>
                            
                            <div class="flex gap-2">
                                <button class="px-4 py-2 bg-orange-500 text-white rounded-lg font-semibold hover:bg-orange-600 transition-colors" type="submit">Reset Password</button>
                                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition-colors" type="button" @onclick="CancelPasswordReset">Cancel</button>
                            </div>
                        </EditForm>
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <NotAuthorised />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private ApplicationUser? _managedUser;
    private bool _loading = true;
    private bool _isAdmin;
    private bool _isLocked;
    private bool _isPublished;
    private bool _twoFactorEnabled;
    private bool _isSelfManagement;
    private string? _message;
    private bool _messageIsError;
    private bool _showResetConfirmation;
    private bool _showPasswordReset;
    private bool _showLockConfirmation;
    private bool _showUnlockOptions;
    private bool _publishOnUnlock;
    private string? _passwordResetError;
    private bool _passwordResetSuccess;
    private string _selectedRole = "User";
    private Guid _currentUserId;
    
    private ResetPasswordModel PasswordResetModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = await UserManager.GetUserAsync(authState.User);
        if (currentUser != null)
        {
            _currentUserId = currentUser.Id;
        }
        
        await LoadUserAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        _loading = true;
        _message = null;
        _showResetConfirmation = false;
        _showPasswordReset = false;
        _showLockConfirmation = false;
        _showUnlockOptions = false;
        _passwordResetError = null;
        _passwordResetSuccess = false;
        _publishOnUnlock = false;

        _managedUser = await UserManager.FindByIdAsync(UserId.ToString());

        if (_managedUser != null)
        {
            var roles = await UserManager.GetRolesAsync(_managedUser);
            _isAdmin = roles.Contains("Admin");
            _twoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(_managedUser);
            _isLocked = _managedUser.LockoutEnd.HasValue && _managedUser.LockoutEnd.Value > DateTimeOffset.UtcNow;
            _isPublished = _managedUser.IsPublished;
            _isSelfManagement = _managedUser.Id == _currentUserId;
            _selectedRole = _isAdmin ? "Admin" : "User";
        }

        _loading = false;
    }

    private void ShowResetConfirmation()
    {
        _showResetConfirmation = true;
        _message = null;
    }

    private void CancelReset()
    {
        _showResetConfirmation = false;
    }

    private void ShowLockConfirmation()
    {
        _showLockConfirmation = true;
        _message = null;
    }

    private void ShowUnlockOptions()
    {
        _showUnlockOptions = true;
        _publishOnUnlock = false;
        _message = null;
    }

    private void CancelLockUnlock()
    {
        _showLockConfirmation = false;
        _showUnlockOptions = false;
        _publishOnUnlock = false;
    }

    private async Task LockAccountAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            // Lock the account and unpublish profile
            _managedUser.LockoutEnd = DateTimeOffset.MaxValue;
            _managedUser.IsPublished = false;
            
            var result = await UserManager.UpdateAsync(_managedUser);
            
            if (result.Succeeded)
            {
                _isLocked = true;
                _isPublished = false;
                _showLockConfirmation = false;
                _message = $"Account '{_managedUser.UserName}' has been locked and unpublished.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to lock account: {string.Join("; ", result.Errors.Select(e => e.Description))}";
                _messageIsError = true;
            }
        }
        catch (Exception)
        {
            _message = "An error occurred while locking the account. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private async Task UnlockAccountAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            // Unlock the account
            _managedUser.LockoutEnd = null;
            
            // Optionally publish profile
            if (_publishOnUnlock)
            {
                _managedUser.IsPublished = true;
            }
            
            var result = await UserManager.UpdateAsync(_managedUser);
            
            if (result.Succeeded)
            {
                _isLocked = false;
                _isPublished = _managedUser.IsPublished;
                _showUnlockOptions = false;
                _message = $"Account '{_managedUser.UserName}' has been unlocked" + (_publishOnUnlock ? " and published" : "") + ".";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to unlock account: {string.Join("; ", result.Errors.Select(e => e.Description))}";
                _messageIsError = true;
            }
        }
        catch (Exception)
        {
            _message = "An error occurred while unlocking the account. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private async Task PublishProfileAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            _managedUser.IsPublished = true;
            var result = await UserManager.UpdateAsync(_managedUser);
            
            if (result.Succeeded)
            {
                _isPublished = true;
                _message = $"Profile for '{_managedUser.UserName}' has been published.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to publish profile: {string.Join("; ", result.Errors.Select(e => e.Description))}";
                _messageIsError = true;
            }
        }
        catch (Exception)
        {
            _message = "An error occurred while publishing the profile. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private async Task UnpublishProfileAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            _managedUser.IsPublished = false;
            var result = await UserManager.UpdateAsync(_managedUser);
            
            if (result.Succeeded)
            {
                _isPublished = false;
                _message = $"Profile for '{_managedUser.UserName}' has been unpublished.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to unpublish profile: {string.Join("; ", result.Errors.Select(e => e.Description))}";
                _messageIsError = true;
            }
        }
        catch (Exception)
        {
            _message = "An error occurred while unpublishing the profile. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private async Task ResetTwoFactorAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        try
        {
            // Disable 2FA
            await UserManager.SetTwoFactorEnabledAsync(_managedUser, false);
            
            // Reset the authenticator key
            await UserManager.ResetAuthenticatorKeyAsync(_managedUser);

            _twoFactorEnabled = false;
            _showResetConfirmation = false;
            _message = $"Two-factor authentication has been reset for user '{_managedUser.UserName}'. The user will need to set up 2FA again if they wish to re-enable it.";
            _messageIsError = false;
        }
        catch (Exception)
        {
            _message = "An error occurred while resetting two-factor authentication. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private void ShowPasswordReset()
    {
        _showPasswordReset = true;
        _passwordResetError = null;
        _passwordResetSuccess = false;
        PasswordResetModel = new();
    }

    private void CancelPasswordReset()
    {
        _showPasswordReset = false;
        _passwordResetError = null;
        _passwordResetSuccess = false;
        PasswordResetModel = new();
    }

    private async Task ResetPasswordAsync()
    {
        if (_managedUser == null)
        {
            _passwordResetError = "User not found.";
            return;
        }

        if (PasswordResetModel.NewPassword != PasswordResetModel.ConfirmPassword)
        {
            _passwordResetError = "Passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(PasswordResetModel.NewPassword) || PasswordResetModel.NewPassword.Length < 6)
        {
            _passwordResetError = "Password must be at least 6 characters long.";
            return;
        }

        try
        {
            // Remove the existing password
            var removePasswordResult = await UserManager.RemovePasswordAsync(_managedUser);
            
            if (!removePasswordResult.Succeeded)
            {
                _passwordResetError = $"Failed to reset password: {string.Join("; ", removePasswordResult.Errors.Select(e => e.Description))}";
                return;
            }

            // Add the new password
            var addPasswordResult = await UserManager.AddPasswordAsync(_managedUser, PasswordResetModel.NewPassword);
            
            if (!addPasswordResult.Succeeded)
            {
                _passwordResetError = $"Failed to set new password: {string.Join("; ", addPasswordResult.Errors.Select(e => e.Description))}";
                return;
            }

            _passwordResetSuccess = true;
            _passwordResetError = null;
            _message = $"Password has been reset for user '{_managedUser.UserName}'.";
            _messageIsError = false;
            PasswordResetModel = new();
        }
        catch (Exception ex)
        {
            _passwordResetError = $"An error occurred while resetting the password: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task ChangeRoleAsync()
    {
        if (_managedUser == null)
        {
            _message = "User not found.";
            _messageIsError = true;
            return;
        }

        if (_isSelfManagement)
        {
            _message = "You cannot change your own role.";
            _messageIsError = true;
            return;
        }

        try
        {
            // Ensure the Admin role exists
            const string adminRole = "Admin";
            if (!await RoleManager.RoleExistsAsync(adminRole))
            {
                await RoleManager.CreateAsync(new IdentityRole<Guid>(adminRole));
            }

            // Get current roles
            var currentRoles = await UserManager.GetRolesAsync(_managedUser);
            
            // Remove from all roles
            if (currentRoles.Count > 0)
            {
                var removeResult = await UserManager.RemoveFromRolesAsync(_managedUser, currentRoles);
                if (!removeResult.Succeeded)
                {
                    _message = $"Failed to remove roles: {string.Join("; ", removeResult.Errors.Select(e => e.Description))}";
                    _messageIsError = true;
                    return;
                }
            }

            // Add to new role if it's Admin
            if (_selectedRole == "Admin")
            {
                var addResult = await UserManager.AddToRoleAsync(_managedUser, adminRole);
                if (!addResult.Succeeded)
                {
                    _message = $"Failed to add role: {string.Join("; ", addResult.Errors.Select(e => e.Description))}";
                    _messageIsError = true;
                    return;
                }
            }

            _message = $"User '{_managedUser.UserName}' role changed to {_selectedRole}.";
            _messageIsError = false;
            
            // Reload user data to refresh role badge
            await LoadUserAsync();
        }
        catch (Exception)
        {
            _message = "An error occurred while changing the user role. Please try again.";
            _messageIsError = true;
        }

        StateHasChanged();
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required")]
        [StringLength(100, ErrorMessage = "Password must be at least {2} characters long.", MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password confirmation is required")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

