@page "/edit/preview"
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ProfileDisplayModelFactory ProfileFactory
@inject NavigationManager Nav

@using Beanstalk.App.Components.Common
@using Beanstalk.App.Components.View
@using Beanstalk.App.Features.ProfileDisplay
@using Beanstalk.Database.Entities

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading preview...</p>
            }
            else if (_username is null)
            {
                <div class="card-cute text-center py-12">
                    <p class="text-gray-600">Unable to load preview.</p>
                </div>
            }
            else if (_previewModel is null)
            {
                <div class="card-cute bg-yellow-50 border border-yellow-200">
                    <h4 class="text-xl font-semibold text-yellow-800 mb-2">Profile Not Ready</h4>
                    <p class="text-yellow-700 mb-4">Your profile needs to be set up before you can preview it. Make sure you have:</p>
                    <ul class="list-disc list-inside text-yellow-700 space-y-1 mb-4">
                        <li>Enabled your profile page</li>
                        <li>Added a display name</li>
                        <li>Selected a theme</li>
                    </ul>
                    <div class="flex gap-3">
                        <a href="/edit/dashboard" class="btn-primary">Go to Dashboard</a>
                        <a href="/edit/appearance" class="btn-secondary">Choose Theme</a>
                    </div>
                </div>
            }
            else
            {
                <h3 class="text-3xl font-bold mb-4 text-gray-900">Preview</h3>
                <p class="text-gray-600 mb-8">See how your profile looks to visitors.</p>

                <div class="space-y-6">
                    <div class="flex gap-3 mb-6">
                        <a href="/@_username" target="_blank" class="btn-primary">
                            Open in New Tab
                        </a>
                        <button class="btn-secondary" @onclick="RefreshPreview">
                            Refresh
                        </button>
                    </div>

                    <!-- Preview Frame -->
                    <div class="card-cute p-0 overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
                        <!-- Device Frame Header (optional) -->
                        <div class="bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                            </div>
                            <div class="flex-1 text-center">
                                <span class="text-sm font-medium text-gray-600">@_username</span>
                            </div>
                            <div class="w-16"></div>
                        </div>

                        <!-- Preview Content -->
                        <div class="preview-container" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                            @if (_previewModel is not null)
                            {
                                var backgroundStyle = $"background: linear-gradient(135deg, {_previewModel.Theme.BackgroundGradient1} 0%, {_previewModel.Theme.BackgroundGradient2} 100%);";
                                var titleStyle = $"color: {_previewModel.Theme.TitleForeground};";
                                var contentStyle = $"color: {_previewModel.Theme.ContentForeground};";
                                var linkStyle = $"background-color: {_previewModel.Theme.ContainerBackground}; color: {_previewModel.Theme.ContainerForeground}; border: none;";

                                <div class="min-h-screen w-full" style="@backgroundStyle">
                                    <div class="container mx-auto py-12 px-4">
                                        <div class="flex justify-center">
                                            <div class="w-full sm:w-10/12 md:w-2/3 lg:w-2/5">
                                                <div class="text-center mb-8">
                                                    @if (_previewModel.ImageUrl is not null)
                                                    {
                                                        <img src="@_previewModel.ImageUrl" alt="Profile" class="rounded-full mb-6 w-36 h-36 object-cover border-4 border-white shadow-lg mx-auto"/>
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-full mb-6 w-36 h-36 bg-white/20 border-4 border-white shadow-lg mx-auto flex items-center justify-center">
                                                            <span class="text-5xl">🌱</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_previewModel.Title))
                                                    {
                                                        <h1 class="text-3xl font-bold mb-4" style="@titleStyle">@_previewModel.Title</h1>
                                                    }
                                                    else
                                                    {
                                                        <h1 class="text-3xl font-bold mb-4 opacity-50" style="@titleStyle">Your Display Name</h1>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_previewModel.Bio))
                                                    {
                                                        <p class="text-lg mb-6 leading-relaxed" style="@contentStyle">@_previewModel.Bio</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-lg mb-6 opacity-50 italic" style="@contentStyle">Add a bio to tell visitors about yourself...</p>
                                                    }
                                                </div>

                                                @if (_previewModel.Links.Any())
                                                {
                                                    <div class="space-y-3 mb-6">
                                                        @foreach (var link in _previewModel.Links)
                                                        {
                                                            <a href="@link.Url" target="_blank" rel="noopener" style="@linkStyle" class="flex justify-center items-center text-center py-4 px-6 rounded-2xl border-0 shadow-lg transition-all duration-200 hover:-translate-y-1 hover:shadow-xl">
                                                                <span class="font-semibold text-lg">@link.Title</span>
                                                                <span class="ml-2 text-xl">🔗</span>
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center py-8 px-4 bg-white/20 backdrop-blur-sm rounded-2xl border-2 border-dashed border-white/30">
                                                        <span class="text-4xl mb-3 block">🔗</span>
                                                        <p class="text-white/80 font-medium">No links added yet</p>
                                                        <p class="text-white/60 text-sm mt-2">Add links to your profile to get started</p>
                                                        <a href="/edit/links" class="mt-4 inline-block px-6 py-2 bg-white/30 backdrop-blur-sm rounded-xl text-white font-semibold hover:bg-white/40 transition-colors">
                                                            Add Links
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Quick Stats & Info -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="card-cute">
                            <div class="text-sm text-gray-600 mb-1">Theme</div>
                            <div class="font-semibold text-gray-800">@(_previewModel?.Theme != null ? "Applied" : "Not Set")</div>
                        </div>
                        <div class="card-cute">
                            <div class="text-sm text-gray-600 mb-1">Links</div>
                            <div class="font-semibold text-gray-800">@(_previewModel?.Links?.Count ?? 0) @((_previewModel?.Links?.Count ?? 0) == 1 ? "Link" : "Links")</div>
                        </div>
                        <div class="card-cute">
                            <div class="text-sm text-gray-600 mb-1">Profile Image</div>
                            <div class="font-semibold text-gray-800">@(_previewModel?.ImageUrl != null ? "Set" : "Not Set")</div>
                        </div>
                    </div>

                    <!-- Tips -->
                    <div class="card-cute bg-blue-50 border border-blue-200">
                        <h4 class="text-lg font-semibold text-blue-800 mb-3">Preview Tips</h4>
                        <ul class="space-y-2 text-blue-700">
                            <li class="flex items-start gap-2">
                                <span class="text-blue-500 mt-1">•</span>
                                <span>This preview shows exactly how visitors will see your profile</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-500 mt-1">•</span>
                                <span>Make sure your profile is enabled in Dashboard settings</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-500 mt-1">•</span>
                                <span>Click "Open in New Tab" to test the full experience</span>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <PleaseLogIn/>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private string? _username = null;
    private ProfileDisplayModel? _previewModel = null;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPreview();
    }

    private async Task LoadPreview()
    {
        _loading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);

        if (user != null)
        {
            _username = user.UserName;
            if (!string.IsNullOrEmpty(_username))
            {
                try
                {
                    _previewModel = await ProfileFactory.TryGetProfile(_username);
                }
                catch
                {
                    // Profile might not be ready yet
                    _previewModel = null;
                }
            }
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task RefreshPreview()
    {
        await LoadPreview();
    }
}
