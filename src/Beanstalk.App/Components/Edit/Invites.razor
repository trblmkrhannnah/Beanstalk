@page "/edit/invites"
@rendermode InteractiveServer

@using Beanstalk.App.Components.Common
@using Beanstalk.Database.Data
@using Beanstalk.Database.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Cryptography
@using Microsoft.Extensions.DependencyInjection

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <h3 class="text-3xl font-bold mb-4 text-gray-900">Invite Links</h3>
            <p class="text-gray-600 mb-8">Create and manage invite links for new user registrations.</p>

            <div class="mb-6">
                <button class="btn-primary" @onclick="ShowCreateForm">
                    Create New Invite
                </button>
            </div>

            @if (_showCreateForm)
            {
                <div class="card-cute mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-xl font-semibold text-gray-800">Create New Invite Link</h4>
                        <button class="text-gray-500 hover:text-gray-700 text-2xl leading-none" @onclick="HideCreateForm">×</button>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <label for="maxUses" class="block text-sm font-medium text-gray-700 mb-2">Max Uses</label>
                            <select id="maxUses" class="input-cute" @bind="_newInviteMaxUses">
                                <option value="1">1 use</option>
                                <option value="5">5 uses</option>
                                <option value="10">10 uses</option>
                                <option value="25">25 uses</option>
                                <option value="50">50 uses</option>
                                <option value="">Unlimited</option>
                            </select>
                            <p class="text-sm text-gray-600 mt-1">How many times can this invite be used?</p>
                        </div>
                        <div>
                            <label for="comment" class="block text-sm font-medium text-gray-700 mb-2">Comment (optional)</label>
                            <input type="text" id="comment" class="input-cute" @bind="_newInviteComment" placeholder="e.g., For John Doe" />
                            <p class="text-sm text-gray-600 mt-1">Add a note to help remember what this invite is for</p>
                        </div>
                        <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg border border-gray-200">
                            <input type="checkbox" class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500" id="autoDelete" @bind="_newInviteAutoDelete" />
                            <label class="text-sm font-medium text-gray-700 cursor-pointer" for="autoDelete">
                                Auto-delete when expired
                            </label>
                        </div>
                        <p class="text-xs text-gray-500">Automatically remove this link when it expires or reaches max uses</p>
                        <div class="flex gap-3 pt-2">
                            <button class="btn-primary" @onclick="CreateInviteAsync">Create Invite</button>
                            <button class="btn-secondary" @onclick="HideCreateForm">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @if (_loading)
            {
                <p class="text-center text-gray-600 text-lg py-12">Loading invites...</p>
            }
            else if (_invites.Count == 0)
            {
                <div class="card-cute p-8 text-center bg-gray-50">
                    <p class="text-gray-600 text-xl mb-4">No invite links found.</p>
                    <p class="text-gray-700 mb-6">Click the button above to create your first invite link!</p>
                    <button class="btn-primary" @onclick="ShowCreateForm">
                        Create First Invite
                    </button>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var invite in _invites)
                    {
                        var isExpired = IsExpired(invite);
                        var inviteUrl = $"{Nav.BaseUri}join/{invite.Code}";
                        var usesText = invite.MaxUses.HasValue ? $"{invite.CurrentUses}/{invite.MaxUses}" : $"{invite.CurrentUses}/∞";
                        
                        <div class="card-cute">
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <!-- Left: Code and Info -->
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-3">
                                        <code class="px-3 py-1 bg-gray-100 rounded-lg text-sm font-mono text-gray-800">@invite.Code</code>
                                        @if (isExpired)
                                        {
                                            <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-xs font-semibold">Expired</span>
                                        }
                                        else if (invite.IsActive)
                                        {
                                            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold">Active</span>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-semibold">Inactive</span>
                                        }
                                    </div>
                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                                        <div>
                                            <span class="text-gray-500">Uses:</span>
                                            <span class="font-semibold text-gray-800 ml-1">@usesText</span>
                                        </div>
                                        <div>
                                            <span class="text-gray-500">Created:</span>
                                            <span class="font-semibold text-gray-800 ml-1">@invite.CreatedUtc.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <input type="checkbox" 
                                                   class="w-4 h-4 text-pink-500 border-gray-300 rounded focus:ring-2 focus:ring-pink-400" 
                                                   checked="@invite.AutoDeleteWhenExpired"
                                                   @onchange="@(e => ToggleAutoDeleteAsync(invite))" />
                                            <span class="text-gray-500 text-xs">Auto-delete</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(invite.Comment))
                                        {
                                            <div>
                                                <span class="text-gray-500">Comment:</span>
                                                <span class="font-medium text-gray-800 ml-1">@invite.Comment</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Right: Actions -->
                                <div class="flex items-center gap-2 flex-shrink-0">
                                    <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold hover:bg-gray-200 transition-colors" 
                                            @onclick="@(() => CopyToClipboardAsync(inviteUrl))"
                                            title="Copy full link">
                                        Copy Link
                                    </button>
                                    @if (!isExpired)
                                    {
                                        <button class="px-4 py-2 @(invite.IsActive ? "bg-yellow-100 text-yellow-700 hover:bg-yellow-200" : "bg-green-100 text-green-700 hover:bg-green-200") rounded-lg text-sm font-semibold transition-colors" 
                                                @onclick="@(() => ToggleActiveAsync(invite))">
                                            @(invite.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    }
                                    <button class="px-4 py-2 bg-red-100 text-red-700 rounded-lg text-sm font-semibold hover:bg-red-200 transition-colors" 
                                            @onclick="@(() => DeleteInviteAsync(invite))">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="mt-4 p-4 @(_messageIsError ? "bg-red-50 border-2 border-red-200 text-red-700" : "bg-green-50 border-2 border-green-200 text-green-700") rounded-2xl" role="alert">
                    @_message
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <NotAuthorised />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private List<InviteLink> _invites = new();
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private bool _showCreateForm = false;
    private string? _newInviteMaxUses = "10";
    private string? _newInviteComment = "";
    private bool _newInviteAutoDelete = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvitesAsync();
    }

    private async Task LoadInvitesAsync()
    {
        _loading = true;
        
        await using var db = await DbFactory.CreateDbContextAsync();
        
        // Auto-delete expired invites that have auto-delete enabled
        var expiredAutoDeleteInvites = await db.InviteLinks
            .Where(i => i.AutoDeleteWhenExpired && 
                       (!i.IsActive || 
                        (i.MaxUses.HasValue && i.CurrentUses >= i.MaxUses.Value) ||
                        (i.ExpiresUtc.HasValue && i.ExpiresUtc.Value < DateTime.UtcNow)))
            .ToListAsync();
        
        if (expiredAutoDeleteInvites.Any())
        {
            db.InviteLinks.RemoveRange(expiredAutoDeleteInvites);
            await db.SaveChangesAsync();
        }
        
        _invites = await db.InviteLinks
            .AsNoTracking()
            .Include(i => i.CreatedBy)
            .OrderByDescending(i => i.CreatedUtc)
            .ToListAsync();
        _loading = false;
    }

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        _message = null;
    }

    private void HideCreateForm()
    {
        _showCreateForm = false;
        _newInviteMaxUses = "10";
        _newInviteComment = "";
        _newInviteAutoDelete = false;
    }

    private async Task CreateInviteAsync()
    {
        _message = null;
        _messageIsError = false;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = await UserManager.GetUserAsync(authState.User);
        
        if (currentUser == null)
        {
            _message = "Unable to determine current user.";
            _messageIsError = true;
            return;
        }

        // Generate a unique, URL-safe code
        var code = GenerateInviteCode();

        // Parse max uses
        int? maxUses = null;
        if (!string.IsNullOrEmpty(_newInviteMaxUses) && int.TryParse(_newInviteMaxUses, out var parsedMaxUses))
        {
            maxUses = parsedMaxUses;
        }

        var invite = new InviteLink
        {
            Id = Guid.NewGuid(),
            Code = code,
            CreatedByUserId = currentUser.Id,
            CreatedUtc = DateTime.UtcNow,
            MaxUses = maxUses,
            CurrentUses = 0,
            IsActive = true,
            Comment = string.IsNullOrWhiteSpace(_newInviteComment) ? null : _newInviteComment.Trim(),
            AutoDeleteWhenExpired = _newInviteAutoDelete
        };

        await using var db = await DbFactory.CreateDbContextAsync();
        
        db.InviteLinks.Add(invite);
        await db.SaveChangesAsync();

        _message = "Invite link created successfully!";
        _messageIsError = false;
        _showCreateForm = false;
        _newInviteMaxUses = "10";
        _newInviteComment = "";
        _newInviteAutoDelete = false;
        
        await LoadInvitesAsync();
    }

    private async Task ToggleActiveAsync(InviteLink invite)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        var inviteToUpdate = await db.InviteLinks.FindAsync(invite.Id);
        if (inviteToUpdate != null)
        {
            inviteToUpdate.IsActive = !inviteToUpdate.IsActive;
            await db.SaveChangesAsync();
            invite.IsActive = inviteToUpdate.IsActive;
        }
        
        _message = $"Invite link {(invite.IsActive ? "activated" : "deactivated")}.";
        _messageIsError = false;
    }

    private async Task ToggleAutoDeleteAsync(InviteLink invite)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        var inviteToUpdate = await db.InviteLinks.FindAsync(invite.Id);
        if (inviteToUpdate != null)
        {
            inviteToUpdate.AutoDeleteWhenExpired = !inviteToUpdate.AutoDeleteWhenExpired;
            await db.SaveChangesAsync();
            invite.AutoDeleteWhenExpired = inviteToUpdate.AutoDeleteWhenExpired;
        }
        
        _message = $"Auto-delete {(invite.AutoDeleteWhenExpired ? "enabled" : "disabled")} for invite link.";
        _messageIsError = false;
    }

    private async Task DeleteInviteAsync(InviteLink invite)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete this invite link? This action cannot be undone.");
        
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        
        var inviteToDelete = await db.InviteLinks.FindAsync(invite.Id);
        if (inviteToDelete != null)
        {
            db.InviteLinks.Remove(inviteToDelete);
            await db.SaveChangesAsync();
        }
        
        _message = "Invite link deleted.";
        _messageIsError = false;
        
        await LoadInvitesAsync();
    }

    private async Task CopyToClipboardAsync(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _message = "Link copied to clipboard!";
        _messageIsError = false;
    }

    private bool IsExpired(InviteLink invite)
    {
        if (!invite.IsActive)
            return false; // Not expired, just inactive
        
        if (invite.MaxUses.HasValue && invite.CurrentUses >= invite.MaxUses.Value)
            return true;
        
        if (invite.ExpiresUtc.HasValue && invite.ExpiresUtc.Value < DateTime.UtcNow)
            return true;
        
        return false;
    }

    private string GenerateInviteCode()
    {
        // Generate a URL-safe code
        var bytes = RandomNumberGenerator.GetBytes(8);
        var code = Convert.ToBase64String(bytes)
            .Replace("+", "")
            .Replace("/", "")
            .Replace("=", "")
            .Substring(0, 10);
        return code;
    }
}



