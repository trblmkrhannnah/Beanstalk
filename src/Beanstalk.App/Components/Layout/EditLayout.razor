@using Beanstalk.Database.Entities
@using Beanstalk.Database.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase

<input type="checkbox" title="Navigation menu" id="edit-navbar-toggler" class="edit-navbar-toggler sr-only"/>
<label for="edit-navbar-toggler" class="hamburger-menu fixed top-4 right-4 md:hidden z-50 cursor-pointer w-11 h-11 flex items-center justify-center bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition-all duration-200">
    <span class="hamburger-icon relative">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </span>
</label>

<div class="relative flex flex-col md:flex-row h-screen overflow-hidden">
    <div class="bg-gray-50 md:w-64 md:h-screen md:sticky md:top-0 md:border-r border-gray-300 flex flex-col fixed md:relative top-0 left-0 right-0 md:inset-auto h-auto md:h-screen z-30 md:z-auto">
        <div class="px-4 py-4 flex-shrink-0 relative md:static">
            <div class="max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl mx-auto py-6 sm:py-8 md:py-12">
                <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6 sm:mb-8">
                    <img src="Beanstalk.svg" alt="Beanstalk Logo" class="h-12 w-12 sm:h-16 sm:w-16 drop-shadow-lg" />
                </div>
            </div>
        </div>

        <div class="edit-nav-scrollable hidden md:flex md:flex-col md:flex-1 md:overflow-y-auto py-4" onclick="document.getElementById('edit-navbar-toggler')?.click()">
            <nav class="flex flex-col md:flex-1 px-3 space-y-1">
                <AuthorizeView>
                    <Authorized>
                        @if (!string.IsNullOrEmpty(_username))
                        {
                            <a class="bg-indigo-600 text-white rounded-lg px-3 py-2.5 text-sm font-medium text-center transition-all duration-200 flex items-center justify-center gap-2 hover:bg-indigo-700 mb-4 min-h-[44px]" href="/@_username" target="_blank" rel="noopener">
                                View Profile
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </a>
                        }
                    </Authorized>
                </AuthorizeView>
                
                <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/bio" Match="NavLinkMatch.All">
                    Bio
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/appearance" Match="NavLinkMatch.All">
                    Appearance
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/images" Match="NavLinkMatch.All">
                    Images
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/links" Match="NavLinkMatch.All">
                    Links
                </NavLink>
                
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="pt-4 mt-4 border-t border-gray-200">
                            <div class="text-xs text-gray-500 px-3 py-1.5 uppercase tracking-wider font-semibold">Administration</div>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/invites" Match="NavLinkMatch.All">
                                Invites
                            </NavLink>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/users" Match="NavLinkMatch.All">
                                Users
                            </NavLink>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 mt-1 min-h-[44px]" href="/edit/settings" Match="NavLinkMatch.All">
                                Settings
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                
                <div class="pt-4 mt-4 border-t border-gray-200">
                    <div class="text-xs text-gray-500 px-3 py-1.5 uppercase tracking-wider font-semibold">Account</div>
                    <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="/edit/account" Match="NavLinkMatch.All">
                        Settings
                    </NavLink>
                    <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-red-50 hover:text-red-700 hover:font-semibold transition-all duration-200 min-h-[44px]" href="/home/logout" Match="NavLinkMatch.All">
                        Logout
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>

    <main class="flex-1 overflow-y-auto pt-16 md:pt-0">
        <article class="content px-4 sm:px-6 md:px-8 lg:px-12 py-6 sm:py-8 md:py-12">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 w-full bg-yellow-200 shadow-lg p-3 sm:p-4 z-[1000] border-t border-yellow-300" data-nosnippet>
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
        <span class="text-sm sm:text-base">An unhandled error has occurred.</span>
        <div class="flex gap-3 sm:gap-4">
            <a href="." class="text-blue-600 hover:text-blue-800 underline text-sm sm:text-base">Reload</a>
            <button onclick="document.getElementById('blazor-error-ui').classList.add('hidden')" class="cursor-pointer text-gray-600 hover:text-gray-800 text-lg sm:text-xl">🗙</button>
        </div>
    </div>
</div>

<style>
    /* Hamburger icon styling */
    .hamburger-icon {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 20px;
        height: 16px;
        position: relative;
    }
    
    .hamburger-line {
        display: block;
        height: 2.5px;
        width: 100%;
        background-color: #4b5563;
        border-radius: 2px;
        transition: all 0.3s ease;
        transform-origin: center;
    }
    
    .hamburger-menu:hover .hamburger-line {
        background-color: #6366f1;
    }
    
    /* Transform hamburger to X when checked */
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
    }
    
    /* Style the label when checkbox is checked */
    #edit-navbar-toggler:checked ~ .hamburger-menu {
        background-color: #eef2ff;
        border-color: #6366f1;
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-line {
        background-color: #6366f1;
    }
    
    @@media (max-width: 767px) {
        /* Hide navigation menu by default on mobile */
        .edit-nav-scrollable {
            display: none !important;
        }
        
        /* Show navigation menu when toggle is checked */
        #edit-navbar-toggler:checked ~ div .edit-nav-scrollable,
        #edit-navbar-toggler:checked ~ .edit-nav-scrollable {
            display: flex !important;
            flex-direction: column;
            position: fixed;
            top: 4rem;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            z-index: 40;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            padding: 1rem;
        }
    }
</style>

<AntiforgeryToken />

@code {
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId) && Guid.TryParse(userId, out var userGuid))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userGuid);
            _username = user?.UserName;
        }
    }
}