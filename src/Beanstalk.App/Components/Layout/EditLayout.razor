@using Beanstalk.Database.Entities
@using Beanstalk.Database.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase

<input type="checkbox" title="Navigation menu" id="edit-navbar-toggler" class="edit-navbar-toggler sr-only"/>
<label for="edit-navbar-toggler" class="hamburger-menu position-fixed top-0 end-0 d-md-none z-50 d-flex align-items-center justify-content-center bg-white border border-gray-300 rounded shadow-sm hover-bg-indigo-50 hover-border-indigo-300" style="margin: 1rem; width: 44px; height: 44px; cursor: pointer; transition: all 0.2s;">
    <span class="hamburger-icon position-relative">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </span>
</label>

<div class="position-relative d-flex flex-column flex-md-row vh-100 overflow-hidden">
    <div class="bg-gray-50 d-flex flex-column position-md-relative border-gray-300 z-30" style="width: 16rem; height: 100vh; flex-shrink: 0;">
        <div class="px-3 py-3 flex-shrink-0 position-relative">
            <div class="mx-auto py-4 py-sm-5">
                <div class="d-flex align-items-center justify-content-center gap-2 gap-sm-3 mb-4 mb-sm-5">
                    <img src="Beanstalk.svg" alt="Beanstalk Logo" class="drop-shadow-lg" style="height: 3rem; width: 3rem;" />
                </div>
            </div>
        </div>

        <div class="edit-nav-scrollable d-none d-md-flex flex-column flex-md-grow-1 overflow-auto py-3" onclick="document.getElementById('edit-navbar-toggler')?.click()">
            <nav class="d-flex flex-column flex-md-grow-1 px-2" style="gap: 0.25rem;">
                <AuthorizeView>
                    <Authorized>
                        @if (!string.IsNullOrEmpty(_username))
                        {
                            <a class="bg-indigo-600 text-white rounded px-3 py-2 text-decoration-none text-center d-flex align-items-center justify-content-center gap-2 hover-bg-indigo-700 mb-3" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/@_username" target="_blank" rel="noopener">
                                View Profile
                                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </a>
                        }
                    </Authorized>
                </AuthorizeView>
                
                <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/bio" Match="NavLinkMatch.All">
                    Bio
                </NavLink>
                <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/appearance" Match="NavLinkMatch.All">
                    Appearance
                </NavLink>
                <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/images" Match="NavLinkMatch.All">
                    Images
                </NavLink>
                <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/links" Match="NavLinkMatch.All">
                    Links
                </NavLink>
                
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="pt-3 mt-3 border-top border-gray-200">
                            <div class="text-gray-500 px-3 py-2 text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Administration</div>
                            <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/invites" Match="NavLinkMatch.All">
                                Invites
                            </NavLink>
                            <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/users" Match="NavLinkMatch.All">
                                Users
                            </NavLink>
                            <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom mt-1" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/settings" Match="NavLinkMatch.All">
                                Settings
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                
                <div class="pt-3 mt-3 border-top border-gray-200">
                    <div class="text-gray-500 px-3 py-2 text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Account</div>
                    <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-indigo-50 hover-text-indigo-700 nav-link-custom" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/edit/account" Match="NavLinkMatch.All">
                        Settings
                    </NavLink>
                    <NavLink class="text-gray-700 rounded px-3 py-2 text-decoration-none d-flex align-items-center hover-bg-red-50 nav-link-logout" style="min-height: 44px; font-size: 0.875rem; font-weight: 500; transition: all 0.2s;" href="/home/logout" Match="NavLinkMatch.All">
                        Logout
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>

    <main class="flex-grow-1 overflow-auto pt-5 pt-md-0">
        <article class="content px-3 px-sm-4 px-md-5 py-4 py-sm-5">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="d-none position-fixed bottom-0 start-0 w-100 bg-yellow-200 shadow-lg p-3 p-sm-4 border-top border-yellow-300" style="z-index: 1000;" data-nosnippet>
    <div class="container-fluid d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 gap-sm-4" style="max-width: 1280px;">
        <span class="small">An unhandled error has occurred.</span>
        <div class="d-flex gap-3 gap-sm-4">
            <a href="." class="text-blue-600 hover-text-blue-800 text-decoration-underline small">Reload</a>
            <button onclick="document.getElementById('blazor-error-ui').classList.add('d-none')" class="btn btn-link text-gray-600 p-0 fs-5">🗙</button>
        </div>
    </div>
</div>

<style>
    /* Hamburger icon styling */
    .hamburger-icon {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 20px;
        height: 16px;
        position: relative;
    }
    
    .hamburger-line {
        display: block;
        height: 2.5px;
        width: 100%;
        background-color: #4b5563;
        border-radius: 2px;
        transition: all 0.3s ease;
        transform-origin: center;
    }
    
    .hamburger-menu:hover .hamburger-line {
        background-color: #6366f1;
    }
    
    /* Transform hamburger to X when checked */
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
    }
    
    /* Style the label when checkbox is checked */
    #edit-navbar-toggler:checked ~ .hamburger-menu {
        background-color: #eef2ff;
        border-color: #6366f1;
    }
    
    #edit-navbar-toggler:checked ~ .hamburger-menu .hamburger-line {
        background-color: #6366f1;
    }

    /* Nav link active state */
    .nav-link-custom[data-active="true"] {
        background-color: #eef2ff;
        color: #4f46e5;
        font-weight: 600;
    }
    
    .nav-link-custom:hover {
        font-weight: 600;
    }

    .nav-link-logout:hover {
        color: #b91c1c;
        font-weight: 600;
    }
    
    @@media (max-width: 767px) {
        /* Hide navigation sidebar by default on mobile */
        .bg-gray-50 {
            position: fixed !important;
            left: -16rem;
            top: 0;
            transition: left 0.3s ease;
            z-index: 30;
        }
        
        /* Hide navigation menu by default on mobile */
        .edit-nav-scrollable {
            display: none !important;
        }
        
        /* Show navigation menu when toggle is checked */
        #edit-navbar-toggler:checked ~ div .edit-nav-scrollable,
        #edit-navbar-toggler:checked ~ .edit-nav-scrollable {
            display: flex !important;
            flex-direction: column;
            position: fixed;
            top: 4rem;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            z-index: 40;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            padding: 1rem;
        }
        
        /* Show sidebar when toggle is checked */
        #edit-navbar-toggler:checked ~ div.bg-gray-50 {
            left: 0;
        }
    }

    @@media (min-width: 768px) {
        .bg-gray-50 {
            border-right: 1px solid #d1d5db;
        }
    }
</style>

<AntiforgeryToken />

@code {
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId) && Guid.TryParse(userId, out var userGuid))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userGuid);
            _username = user?.UserName;
        }
    }
}
