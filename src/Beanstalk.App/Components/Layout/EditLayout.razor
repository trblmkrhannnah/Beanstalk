@using Beanstalk.Database.Entities
@using Beanstalk.Database.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase

<div class="relative flex flex-col md:flex-row h-screen overflow-hidden">
    <div class="bg-gray-50 md:w-64 h-screen md:sticky md:top-0 border-r border-gray-300 flex flex-col">
        <div class="px-4 py-4 flex-shrink-0">
            <a class="text-lg font-semibold text-gray-900 hover:text-indigo-600 transition-colors" href="">🌱 Beanstalk</a>
        </div>

        <input type="checkbox" title="Navigation menu" id="edit-navbar-toggler" class="edit-navbar-toggler appearance-none cursor-pointer w-10 h-10 text-gray-600 absolute top-4 right-4 bg-white border border-gray-300 rounded-md bg-[url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 30 30%27%3e%3cpath stroke=%27%234b5563%27 stroke-linecap=%27round%27 stroke-miterlimit=%2710%27 stroke-width=%272%27 d=%27M4 7h22M4 15h22M4 23h22%27/%3e%3c/svg%3e')] bg-no-repeat bg-center bg-[length:1.25rem] hover:bg-gray-50 checked:bg-indigo-50 checked:border-indigo-300 md:hidden"/>

        <div class="edit-nav-scrollable hidden md:flex md:flex-col md:flex-1 md:overflow-y-auto py-4" onclick="document.getElementById('edit-navbar-toggler')?.click()">
            <nav class="flex flex-col md:flex-1 px-3 space-y-1">
                <AuthorizeView>
                    <Authorized>
                        @if (!string.IsNullOrEmpty(_username))
                        {
                            <a class="bg-indigo-600 text-white rounded-lg px-3 py-2 text-sm font-medium text-center transition-all duration-200 flex items-center justify-center gap-2 hover:bg-indigo-700 mb-4" href="/@_username" target="_blank" rel="noopener">
                                View Profile
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </a>
                        }
                    </Authorized>
                </AuthorizeView>
                
                <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/bio" Match="NavLinkMatch.All">
                    Bio
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/appearance" Match="NavLinkMatch.All">
                    Appearance
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/images" Match="NavLinkMatch.All">
                    Images
                </NavLink>
                <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/links" Match="NavLinkMatch.All">
                    Links
                </NavLink>
                
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="pt-4 mt-4 border-t border-gray-200">
                            <div class="text-xs text-gray-500 px-3 py-1.5 uppercase tracking-wider font-semibold">Administration</div>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/invites" Match="NavLinkMatch.All">
                                Invites
                            </NavLink>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/users" Match="NavLinkMatch.All">
                                Users
                            </NavLink>
                            <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 mt-1" href="/edit/settings" Match="NavLinkMatch.All">
                                Settings
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                
                <div class="pt-4 mt-4 border-t border-gray-200">
                    <div class="text-xs text-gray-500 px-3 py-1.5 uppercase tracking-wider font-semibold">Account</div>
                    <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200" href="/edit/account" Match="NavLinkMatch.All">
                        Settings
                    </NavLink>
                    <NavLink class="text-gray-700 rounded-md px-3 py-2 text-sm font-medium flex items-center hover:bg-red-50 hover:text-red-700 hover:font-semibold transition-all duration-200" href="/home/logout" Match="NavLinkMatch.All">
                        Logout
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>

    <main class="flex-1 overflow-y-auto">
        <article class="content px-6 md:px-8 lg:px-12 py-8 md:py-12">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 w-full bg-yellow-200 shadow-lg p-4 z-[1000] border-t border-yellow-300" data-nosnippet>
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <span>An unhandled error has occurred.</span>
        <div class="flex gap-4">
            <a href="." class="text-blue-600 hover:text-blue-800 underline">Reload</a>
            <button onclick="document.getElementById('blazor-error-ui').classList.add('hidden')" class="cursor-pointer text-gray-600 hover:text-gray-800">🗙</button>
        </div>
    </div>
</div>

<style>
    .edit-navbar-toggler:checked ~ .edit-nav-scrollable {
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow-y: auto;
        max-height: calc(100vh - 7rem);
    }
</style>

<AntiforgeryToken />

@code {
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId) && Guid.TryParse(userId, out var userGuid))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userGuid);
            _username = user?.UserName;
        }
    }
}