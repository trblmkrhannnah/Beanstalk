@inherits LayoutComponentBase

<div class="relative flex flex-col min-h-screen">
    <PageTitle>Beanstalk</PageTitle>
    <main class="flex-1">
        <article class="content px-4 sm:px-6 md:px-8 lg:px-12 py-6 sm:py-8 md:py-12">
            <div class="max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl mx-auto py-6 sm:py-8 md:py-12">
                <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6 sm:mb-8">
                    <img src="Beanstalk.svg" alt="Beanstalk Logo" class="h-12 w-12 sm:h-16 sm:w-16 drop-shadow-lg" />
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-0 bg-gradient-to-r from-pink-500 to-lavender-500 bg-clip-text text-transparent">Beanstalk</h1>
                </div>
            </div>
            <div class="max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl mx-auto py-6 sm:py-8 md:py-12">
                @Body
            </div>
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 w-full bg-yellow-200 shadow-lg p-3 sm:p-4 z-[1000] border-t border-yellow-300" data-nosnippet>
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
        <span class="text-sm sm:text-base">An unhandled error has occurred.</span>
        <div class="flex gap-3 sm:gap-4">
            <a href="." class="text-blue-600 hover:text-blue-800 underline text-sm sm:text-base">Reload</a>
            <button onclick="document.getElementById('blazor-error-ui').classList.add('hidden')" class="cursor-pointer text-gray-600 hover:text-gray-800 text-lg sm:text-xl">🗙</button>
        </div>
    </div>
</div>

<AntiforgeryToken/>