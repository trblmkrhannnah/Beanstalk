<style>
    /* Hamburger icon styling */
    .hamburger-icon {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 20px;
        height: 16px;
        position: relative;
    }
    
    .hamburger-line {
        display: block;
        height: 2.5px;
        width: 100%;
        background-color: #4b5563;
        border-radius: 2px;
        transition: all 0.3s ease;
        transform-origin: center;
    }
    
    .hamburger-menu:hover .hamburger-line {
        background-color: #6366f1;
    }
    
    /* Transform hamburger to X when checked */
    #navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
    }
    
    #navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    
    #navbar-toggler:checked ~ .hamburger-menu .hamburger-icon .hamburger-line:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
    }
    
    /* Style the label when checkbox is checked */
    #navbar-toggler:checked ~ .hamburger-menu {
        background-color: #eef2ff;
        border-color: #6366f1;
    }
    
    #navbar-toggler:checked ~ .hamburger-menu .hamburger-line {
        background-color: #6366f1;
    }
    
    @@media (max-width: 767px) {
        /* Hide navigation menu by default on mobile */
        .nav-scrollable {
            display: none !important;
        }
        
        /* Show navigation menu when toggle is checked */
        #navbar-toggler:checked ~ .nav-scrollable {
            display: flex !important;
            flex-direction: column;
            position: fixed;
            top: 4rem;
            left: 0;
            right: 0;
            bottom: 0;
            background: white;
            z-index: 40;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            padding: 1rem;
        }
    }
</style>