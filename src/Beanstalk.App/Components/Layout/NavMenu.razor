        <NavLink class="text-gray-700 rounded-md px-3 py-2.5 text-sm font-medium flex items-center hover:bg-indigo-50 hover:text-indigo-700 hover:font-semibold data-[active=true]:bg-indigo-50 data-[active=true]:text-indigo-700 data-[active=true]:font-semibold transition-all duration-200 min-h-[44px]" href="" Match="NavLinkMatch.All">
