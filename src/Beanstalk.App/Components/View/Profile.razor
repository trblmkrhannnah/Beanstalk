@page "/{Username:regex(^[a-zA-Z0-9_-]{{5,}}$)}"
@using Beanstalk.App.Features

@inject ProfileDisplayModelFactory ProfileFactory
@inject BeanstalkNavigator Navigator

@if (Instance is not null)
{
	<PageTitle>@Instance.Title</PageTitle>

	var backgroundStyle = $"background: linear-gradient(135deg, {Instance.Theme.BackgroundGradient1} 0%, {Instance.Theme.BackgroundGradient2} 100%);";
	var titleStyle = $"color: {Instance.Theme.TitleForeground};";
	var contentStyle = $"color: {Instance.Theme.ContentForeground};";
	var linkStyle = $"background-color: {Instance.Theme.ContainerBackground}; color: {Instance.Theme.ContainerForeground}; border: none;";

	<div class="profile-page" style="@backgroundStyle">
		<div class="container py-5">
			<div class="row justify-content-center">
				<div class="col-md-8 col-lg-6">
					<div class="text-center mb-5">
						@if (Instance.ImageUrl is not null)
						{
							<img src="@Instance.ImageUrl" alt="Profile" class="rounded-circle mb-4 profile-image"/>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Title))
						{
							<h1 lass="h3 mb-3" style="@titleStyle">@Instance.Title</h1>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Bio))
						{
							<p lass="text-muted mb-4" style="@contentStyle">@Instance.Bio</p>
						}
					</div>

					<div class="list-group mb-4">
						@foreach (var link in Instance.Links)
						{
							<a href="@link.Url" target="_blank" rel="noopener" style="@linkStyle" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 px-4 mb-2 rounded-3 border-0 shadow-sm link-item">
								<span class="fw-medium">@link.Title</span>
								<i class="bi bi-box-arrow-up-right text-muted"></i>
							</a>
						}
					</div>
					
				</div>
			</div>
		</div>
	</div>
}
else
{
	<PageTitle>Loading</PageTitle>
	<p>Loading...</p>
}

<style>
	.profile-page {
		min-height: 100vh;
	}

	.profile-image {
		width: 140px;
		height: 140px;
		object-fit: cover;
		border: 4px solid white;
		box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
	}

	.link-item {
		transition: all 0.2s ease-in-out;
		background-color: rgba(255, 255, 255, 0.9);
	}

	.link-item:hover {
		transform: translateY(-2px);
		box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
		background-color: white;
	}
</style>

@code
{
	[Parameter] public string Username { get; set; } = string.Empty;

	public ProfileDisplayModel? Instance { get; set; } = null;

	protected override async Task OnParametersSetAsync()
	{
		Instance = await ProfileFactory.TryGetProfile(Username);

		if (Instance is null)
			Navigator.NavigateToProfileNotFound();
	}
}


