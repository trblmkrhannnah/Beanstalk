@page "/{Username:regex(^[a-zA-Z0-9_-]{{5,}}$)}"
@using Beanstalk.App.Features

@inject ProfileDisplayModelFactory ProfileFactory
@inject BeanstalkNavigator Navigator

@if (Instance is not null)
{
	<PageTitle>@Instance.Title</PageTitle>

	var backgroundStyle = $"background: linear-gradient(135deg, {Instance.Theme.BackgroundGradient1} 0%, {Instance.Theme.BackgroundGradient2} 100%);";
	var titleStyle = $"color: {Instance.Theme.TitleForeground};";
	var contentStyle = $"color: {Instance.Theme.ContentForeground};";
	var linkStyle = $"background-color: {Instance.Theme.ContainerBackground}; color: {Instance.Theme.ContainerForeground}; border: none;";

	<div class="min-vh-100 w-100" style="@backgroundStyle">
		<div class="container mx-auto py-4 py-sm-5 px-3 px-sm-4">
			<div class="d-flex justify-content-center">
				<div class="w-100" style="max-width: 40rem;">
					<div class="text-center mb-4 mb-sm-5">
						@if (Instance.ImageUrl is not null)
						{
							<img src="@Instance.ImageUrl" alt="Profile" class="rounded-circle mb-3 mb-sm-4 border border-4 border-white shadow object-fit-cover mx-auto" style="width: 6rem; height: 6rem;"/>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Title))
						{
							<h1 class="h4 h-sm-3 h-md-2 fw-semibold mb-3 px-2" style="@titleStyle; outline: none;">@Instance.Title</h1>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Bio))
						{
							<p class="small text-gray-600 mb-3 mb-sm-4 px-2" style="@contentStyle">@Instance.Bio</p>
						}
					</div>

					<div class="d-flex flex-column gap-3 mb-4">
						@foreach (var link in Instance.Links)
						{
						<a href="@link.Url" target="_blank" rel="noopener" style="@linkStyle" class="d-flex justify-content-center align-items-center text-center py-3 px-3 px-sm-4 rounded border-0 shadow text-decoration-none" onclick="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 12px rgba(0,0,0,0.15)';" onmouseout="this.style.transform=''; this.style.boxShadow='';" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 12px rgba(0,0,0,0.15)';">
							<span class="fw-medium small">@link.Title</span>
							<i class="bi bi-box-arrow-up-right text-gray-500 ms-2"></i>
						</a>
						}
					</div>
					
				</div>
			</div>
		</div>
	</div>
}
else
{
	<PageTitle>Loading</PageTitle>
	<p>Loading...</p>
}


@code
{
	[Parameter] public string Username { get; set; } = string.Empty;

	public ProfileDisplayModel? Instance { get; set; } = null;

	protected override async Task OnParametersSetAsync()
	{
		Instance = await ProfileFactory.TryGetProfile(Username);

		if (Instance is null)
			Navigator.NavigateToProfileNotFound();
	}
}


