@page "/{Username:regex(^[a-zA-Z0-9_-]{{5,}}$)}"
@using Beanstalk.App.Features

@inject ProfileDisplayModelFactory ProfileFactory
@inject BeanstalkNavigator Navigator

@if (Instance is not null)
{
	<PageTitle>@Instance.Title</PageTitle>

	var backgroundStyle = $"background: linear-gradient(135deg, {Instance.Theme.BackgroundGradient1} 0%, {Instance.Theme.BackgroundGradient2} 100%);";
	var titleStyle = $"color: {Instance.Theme.TitleForeground};";
	var contentStyle = $"color: {Instance.Theme.ContentForeground};";
	var linkStyle = $"background-color: {Instance.Theme.ContainerBackground}; color: {Instance.Theme.ContainerForeground}; border: none;";

	<div class="min-h-screen w-full" style="@backgroundStyle">
		<div class="container mx-auto py-12 px-4">
			<div class="flex justify-center">
				<div class="w-full sm:w-10/12 md:w-2/3 lg:w-2/5">
					<div class="text-center mb-8">
						@if (Instance.ImageUrl is not null)
						{
							<img src="@Instance.ImageUrl" alt="Profile" class="rounded-full mb-6 w-36 h-36 object-cover border-4 border-white shadow-md mx-auto"/>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Title))
						{
							<h1 class="text-2xl font-semibold mb-3 outline-none" style="@titleStyle">@Instance.Title</h1>
						}
						@if (!string.IsNullOrWhiteSpace(Instance.Bio))
						{
							<p class="text-gray-600 mb-6" style="@contentStyle">@Instance.Bio</p>
						}
					</div>

					<div class="space-y-3 mb-6">
						@foreach (var link in Instance.Links)
						{
						<a href="@link.Url" target="_blank" rel="noopener" style="@linkStyle" class="flex justify-center items-center text-center py-4 px-6 rounded-xl border-0 shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg bg-white/90 hover:bg-white">
							<span class="font-medium">@link.Title</span>
							<i class="bi bi-box-arrow-up-right text-gray-500 ml-2"></i>
						</a>
						}
					</div>
					
				</div>
			</div>
		</div>
	</div>
}
else
{
	<PageTitle>Loading</PageTitle>
	<p>Loading...</p>
}


@code
{
	[Parameter] public string Username { get; set; } = string.Empty;

	public ProfileDisplayModel? Instance { get; set; } = null;

	protected override async Task OnParametersSetAsync()
	{
		Instance = await ProfileFactory.TryGetProfile(Username);

		if (Instance is null)
			Navigator.NavigateToProfileNotFound();
	}
}


